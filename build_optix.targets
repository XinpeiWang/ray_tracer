<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    OptiX Build Targets
    Compiles OptiX .cu device programs to PTX at build time,
    and compiles wavefront CUDA kernel files to .obj for linking.
  -->

  <PropertyGroup>
    <!-- Prefer MSBuild property override, then environment variables, then repository-defaults -->
    <OptixSdkPath Condition="'$(OptixSdkPath)'=='' and '$(OPTIX_SDK_PATH)' != ''">$(OPTIX_SDK_PATH)</OptixSdkPath>
    <OptixSdkPath Condition="'$(OptixSdkPath)'==''">C:\ProgramData\NVIDIA Corporation\OptiX SDK 9.1.0</OptixSdkPath>

    <CudaToolkitPath Condition="'$(CudaToolkitPath)'=='' and '$(CUDA_TOOLKIT_PATH)' != ''">$(CUDA_TOOLKIT_PATH)</CudaToolkitPath>
    <CudaToolkitPath Condition="'$(CudaToolkitPath)'=='' and '$(CUDA_PATH)' != ''">$(CUDA_PATH)</CudaToolkitPath>
    <CudaToolkitPath Condition="'$(CudaToolkitPath)'==''">C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.2</CudaToolkitPath>

    <OptixOutputDir>$(MSBuildThisFileDirectory)\gpu\optix</OptixOutputDir>

    <!-- Plain CUDA kernels need explicit SASS per architecture (no JIT fallback, see CompileCudaSources' comment): native sm_86 (Ampere) and
         sm_120 (Blackwell). Opt in to compiling only for THIS machine's GPU for quicker development builds with
         `msbuild /p:RtCudaLocalArchOnly=true` or the environment variable RT_CUDA_LOCAL_ARCH_ONLY=1 (see CudaDetectLocalArch). The result
         only runs on that GPU, so do not package it. -->
    <CudaObjArchFlags>-gencode=arch=compute_86,code=sm_86 -gencode=arch=compute_120,code=sm_120</CudaObjArchFlags>
    <!-- How many nvcc processes scripts\cuda_build.ps1 runs at once (each may use a few GB; each also compiles its architectures concurrently via nvcc threads (-t0)). -->
    <CudaParallelJobs Condition="'$(CudaParallelJobs)'=='' and '$(RT_CUDA_JOBS)' != ''">$(RT_CUDA_JOBS)</CudaParallelJobs>
    <CudaParallelJobs Condition="'$(CudaParallelJobs)'==''">6</CudaParallelJobs>
  </PropertyGroup>

  <!-- Source file lists -->
  <ItemGroup>
    <!-- Recursive path tracer OptiX programs -> PTX -->
    <OptixSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\optix_programs.cu" />
    <!-- Wavefront OptiX device programs -> PTX (loaded at runtime) -->
    <WavefrontPtxSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_programs.cu" />
    <!-- Wavefront CUDA compute kernels -> .obj (linked into optix_renderer.lib).
         The 6 wavefront_kernels_*.cu entries are wavefront_kernels.cu's own
         per-kernel-family split (see wavefront_device_helpers.h's own header
         comment) - each recompiles independently (CompileCudaSources below
         decides per file from its own source, the headers nvcc reports it
         included, and its flags), so editing one kernel does not force
         recompiling the others. -->
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_camera.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_materials.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_materials_simple.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_materials_dielectric.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_bssrdf.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_accumulate.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_restir.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_svgf.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_nrc.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels_upscale.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_launch.cu" />
    <!-- SPPM OptiX device programs -> PTX (loaded at runtime) -->
    <SppmPtxSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\sppm_programs.cu" />
    <!-- SPPM plain CUDA compute kernels -> .obj (linked into optix_renderer.lib) -->
    <SppmObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\sppm_kernels.cu" />
    <SppmObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\sppm_launch.cu" />

    <!-- Header dependencies are NOT listed here any more: every compile below writes nvcc's own dependency file (-MD -MF) and
         scripts\cuda_build.ps1 rebuilds a file only when its source, a header it really included, or its flags changed. (This used to be a
         blanket "every header in gpu/optix and src/shared" list, so touching ANY of them - even a host-only header no .cu includes -
         recompiled all 16 CUDA files, ~4 minutes.) -->
  </ItemGroup>

  <!-- ===================================================================== -->
  <!-- Compile every CUDA/OptiX source: 3 PTX modules + the wavefront and    -->
  <!-- SPPM kernel .obj files, in parallel, with exact header dependencies   -->
  <!-- ===================================================================== -->
  <!-- Replaces five per-file MSBuild targets whose Exec calls ran one after another and whose Inputs listed every header in two directories.
       scripts\cuda_build.ps1 does the up-to-date check per file from nvcc's own dependency output, runs -Parallel compiles at a time, and
       prints which files it rebuilt. Outputs and flags are the ones those targets used, plus nvcc threads (-t0) on the .obj files (nvcc compiles the
       two target architectures concurrently: the largest kernel went 78 s -> 51 s with an identical result).

       Why the .obj files carry explicit SASS for each architecture and not embedded PTX: they use relocatable device code, and the dlink step
       below only emits resolved SASS, dropping any embedded PTX, so each supported architecture needs its own gencode entry rather than JIT
       (found when sm_86-only kernels failed with "no device code available" on an RTX 5080). The OptiX PTX modules are always PTX and JIT. -->
  <Target Name="CompileCudaSources"
          Condition="'$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          BeforeTargets="Build">

    <PropertyGroup>
      <NvccPath>$(CudaToolkitPath)\bin\nvcc.exe</NvccPath>
      <CudaWorkDir>$(MSBuildThisFileDirectory.TrimEnd('\'))</CudaWorkDir>
      <CudaGpuDir>$(MSBuildProjectDirectory)\..\gpu\optix</CudaGpuDir>
      <CudaDepDir>$(MSBuildProjectDirectory)\..\gpu\optix\.cudadeps</CudaDepDir>
      <CudaIncludes>-I"$(OptixSdkPath)\include" -I"$(CudaToolkitPath)\include" -I"$(CudaGpuDir)"</CudaIncludes>
      <CudaSharedInclude>-I"$(MSBuildProjectDirectory)\..\src\shared"</CudaSharedInclude>
      <CudaCrt Condition="'$(Configuration)'=='Debug'">-Xcompiler /MDd</CudaCrt>
      <CudaCrt Condition="'$(Configuration)'=='Release'">-Xcompiler /MD</CudaCrt>
      <CudaPtxFlags>--ptx -O3 --split-compile 0 --use_fast_math --relocatable-device-code=true -arch=sm_86 --std=c++17</CudaPtxFlags>
      <CudaObjFlags>-c -O3 --use_fast_math --relocatable-device-code=true $(CudaObjArchFlags) --std=c++17 $(CudaCrt) -t0</CudaObjFlags>
      <CudaPtxJobFlags>$(CudaPtxFlags) $(CudaIncludes)</CudaPtxJobFlags>
      <CudaPtxSharedJobFlags>$(CudaPtxFlags) $(CudaIncludes) $(CudaSharedInclude)</CudaPtxSharedJobFlags>
      <CudaObjJobFlags>$(CudaObjFlags) $(CudaIncludes) $(CudaSharedInclude)</CudaObjJobFlags>
    </PropertyGroup>

    <ItemGroup>
      <!-- source <TAB> output <TAB> flags -->
      <CudaJobLine Include="$(CudaGpuDir)\optix_programs.cu&#9;$(CudaGpuDir)\optix_programs.ptx&#9;$(CudaPtxJobFlags)" />
      <CudaJobLine Include="$(CudaGpuDir)\wavefront_programs.cu&#9;$(CudaGpuDir)\wavefront_programs.ptx&#9;$(CudaPtxSharedJobFlags)" />
      <CudaJobLine Include="$(CudaGpuDir)\sppm_programs.cu&#9;$(CudaGpuDir)\sppm_programs.ptx&#9;$(CudaPtxSharedJobFlags)" />
      <CudaJobLine Include="@(WavefrontObjSource->'%(FullPath)&#9;$(CudaGpuDir)\%(Filename).obj&#9;$(CudaObjJobFlags)')" />
      <CudaJobLine Include="@(SppmObjSource->'%(FullPath)&#9;$(CudaGpuDir)\%(Filename).obj&#9;$(CudaObjJobFlags)')" />
    </ItemGroup>

    <MakeDir Directories="$(CudaDepDir)" />
    <WriteLinesToFile File="$(CudaDepDir)\cuda_jobs.txt" Lines="@(CudaJobLine)" Overwrite="true" />

    <Exec Command='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)scripts\cuda_build.ps1" -JobFile "$(CudaDepDir)\cuda_jobs.txt" -Nvcc "$(NvccPath)" -DepDir "$(CudaDepDir)" -Parallel $(CudaParallelJobs) -WorkDir "$(CudaWorkDir)"'
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />
  </Target>

  <!-- Opt-in: compile the .obj files only for the GPU in this machine (nvidia-smi compute capability), for faster development builds. -->
  <Target Name="CudaDetectLocalArch"
          Condition="('$(RtCudaLocalArchOnly)' == 'true' or '$(RT_CUDA_LOCAL_ARCH_ONLY)' == '1') and '$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          BeforeTargets="CompileCudaSources">
    <Exec Command="nvidia-smi --query-gpu=compute_cap --format=csv,noheader" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RtComputeCapRaw" />
    </Exec>
    <PropertyGroup>
      <_RtComputeCap>$([System.Text.RegularExpressions.Regex]::Match('$(_RtComputeCapRaw)', '\d+\.\d+').Value.Replace('.', ''))</_RtComputeCap>
      <CudaObjArchFlags Condition="'$(_RtComputeCap)' != ''">-gencode=arch=compute_$(_RtComputeCap),code=sm_$(_RtComputeCap)</CudaObjArchFlags>
    </PropertyGroup>
    <Message Importance="High" Text="[CUDA] local-architecture-only build: sm_$(_RtComputeCap) (development builds only - the kernels will not run on other GPUs)" Condition="'$(_RtComputeCap)' != ''" />
    <Warning Text="RtCudaLocalArchOnly was requested but nvidia-smi gave no compute capability; building for the default architectures." Condition="'$(_RtComputeCap)' == ''" />
  </Target>

  <!-- ===================================================================== -->
  <!-- Device-link wavefront .obj files -> wavefront_dlink.obj               -->
  <!-- Resolves __cudaRegisterLinkedBinary_* for the host linker.            -->
  <!-- This must run after both .cu -> .obj compiles and before Lib.         -->
  <!-- ===================================================================== -->
  <Target Name="DeviceLinkWavefront"
          Condition="'$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          AfterTargets="CompileCudaSources"
          BeforeTargets="Lib"
          Inputs="@(WavefrontObjSource->'$(MSBuildProjectDirectory)\..\gpu\optix\%(Filename).obj')"
          Outputs="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_dlink.obj">
    <!-- Without Inputs/Outputs, MSBuild has no way to skip this target, so
         nvcc -dlink ran unconditionally on every build (even a genuine
         no-op) - its output always got a fresh mtime, which invalidated
         Lib's AdditionalDependencies check and forced a full relink of
         every consuming exe every time. Measured ~41s on every single
         build before this fix, incremental or not.

         Inputs (and DlinkInputs below) are an item-list transform over
         @(WavefrontObjSource) rather than a hardcoded pair of filenames, so
         a future split (or a brand new wavefront kernel file) only needs an
         entry added to that item list above - never a hand-edit here. -->

    <Message Text="[CUDA] Device-linking wavefront objs -> wavefront_dlink.obj..." Importance="High" />

    <PropertyGroup>
      <NvccPath>$(CudaToolkitPath)\bin\nvcc.exe</NvccPath>
      <DlinkFlags>-dlink $(CudaObjArchFlags)</DlinkFlags>
      <DlinkFlags Condition="'$(Configuration)'=='Debug'">$(DlinkFlags) -Xcompiler /MDd -G</DlinkFlags>
      <DlinkFlags Condition="'$(Configuration)'=='Release'">$(DlinkFlags) -Xcompiler /MD</DlinkFlags>
      <DlinkInputs>@(WavefrontObjSource->'"$(MSBuildProjectDirectory)\..\gpu\optix\%(Filename).obj"', ' ')</DlinkInputs>
      <DlinkOut>$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_dlink.obj</DlinkOut>
    </PropertyGroup>

    <Exec Command='"$(NvccPath)" $(DlinkFlags) $(DlinkInputs) -o "$(DlinkOut)"'
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />

    <Message Text="[CUDA] Device-linked: $(DlinkOut)" Importance="High" />
  </Target>

  <!-- ===================================================================== -->
  <!-- Device-link SPPM .obj files -> sppm_dlink.obj                         -->
  <!-- Resolves __cudaRegisterLinkedBinary_* for the host linker.            -->
  <!-- This must run after both .cu -> .obj compiles and before Lib.         -->
  <!-- ===================================================================== -->
  <Target Name="DeviceLinkSppm"
          Condition="'$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          AfterTargets="CompileCudaSources"
          BeforeTargets="Lib"
          Inputs="$(MSBuildProjectDirectory)\..\gpu\optix\sppm_kernels.obj;$(MSBuildProjectDirectory)\..\gpu\optix\sppm_launch.obj"
          Outputs="$(MSBuildProjectDirectory)\..\gpu\optix\sppm_dlink.obj">

    <Message Text="[CUDA] Device-linking SPPM objs -> sppm_dlink.obj..." Importance="High" />

    <PropertyGroup>
      <NvccPath>$(CudaToolkitPath)\bin\nvcc.exe</NvccPath>
      <DlinkFlags>-dlink $(CudaObjArchFlags)</DlinkFlags>
      <DlinkFlags Condition="'$(Configuration)'=='Debug'">$(DlinkFlags) -Xcompiler /MDd -G</DlinkFlags>
      <DlinkFlags Condition="'$(Configuration)'=='Release'">$(DlinkFlags) -Xcompiler /MD</DlinkFlags>
      <SppmDlinkIn1>$(MSBuildProjectDirectory)\..\gpu\optix\sppm_kernels.obj</SppmDlinkIn1>
      <SppmDlinkIn2>$(MSBuildProjectDirectory)\..\gpu\optix\sppm_launch.obj</SppmDlinkIn2>
      <SppmDlinkOut>$(MSBuildProjectDirectory)\..\gpu\optix\sppm_dlink.obj</SppmDlinkOut>
    </PropertyGroup>

    <Exec Command='"$(NvccPath)" $(DlinkFlags) "$(SppmDlinkIn1)" "$(SppmDlinkIn2)" -o "$(SppmDlinkOut)"'
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />

    <Message Text="[CUDA] Device-linked: $(SppmDlinkOut)" Importance="High" />
  </Target>

  <!-- ===================================================================== -->
  <!-- Clean OptiX outputs                                                    -->
  <!-- ===================================================================== -->
  <Target Name="CleanOptixPrograms" AfterTargets="Clean">
    <ItemGroup>
      <OptixPtxFiles Include="$(OptixOutputDir)\*.ptx" />
      <!-- Transforms over @(WavefrontObjSource)/@(SppmObjSource) (both
           declared above, in this same file, so - unlike optix_renderer.
           vcxproj's AdditionalDependencies, which can't see these item
           lists at all due to import order - a future kernel split only
           needs an entry added up there, never a hand-edit here too. -->
      <OptixObjFiles Include="@(WavefrontObjSource->'$(OptixOutputDir)\%(Filename).obj')" />
      <OptixObjFiles Include="@(SppmObjSource->'$(OptixOutputDir)\%(Filename).obj')" />
      <OptixObjFiles Include="$(OptixOutputDir)\wavefront_dlink.obj;$(OptixOutputDir)\sppm_dlink.obj" />
    </ItemGroup>
    <Delete Files="@(OptixPtxFiles);@(OptixObjFiles)" />
    <RemoveDir Directories="$(OptixOutputDir)\.cudadeps" />
    <Message Text="[OptiX] Cleaned PTX and CUDA obj files" Importance="High" />
  </Target>

</Project>
