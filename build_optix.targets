<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    OptiX Build Targets
    Compiles OptiX .cu device programs to PTX at build time,
    and compiles wavefront CUDA kernel files to .obj for linking.
  -->

  <PropertyGroup>
    <!-- Prefer MSBuild property override, then environment variables, then repository-defaults -->
    <OptixSdkPath Condition="'$(OptixSdkPath)'=='' and '$(OPTIX_SDK_PATH)' != ''">$(OPTIX_SDK_PATH)</OptixSdkPath>
    <OptixSdkPath Condition="'$(OptixSdkPath)'==''">C:\ProgramData\NVIDIA Corporation\OptiX SDK 9.1.0</OptixSdkPath>

    <CudaToolkitPath Condition="'$(CudaToolkitPath)'=='' and '$(CUDA_TOOLKIT_PATH)' != ''">$(CUDA_TOOLKIT_PATH)</CudaToolkitPath>
    <CudaToolkitPath Condition="'$(CudaToolkitPath)'=='' and '$(CUDA_PATH)' != ''">$(CUDA_PATH)</CudaToolkitPath>
    <CudaToolkitPath Condition="'$(CudaToolkitPath)'==''">C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.2</CudaToolkitPath>

    <OptixOutputDir>$(MSBuildThisFileDirectory)\gpu\optix</OptixOutputDir>
  </PropertyGroup>

  <!-- Source file lists -->
  <ItemGroup>
    <!-- Recursive path tracer OptiX programs -> PTX -->
    <OptixSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\optix_programs.cu" />
    <!-- Wavefront OptiX device programs -> PTX (loaded at runtime) -->
    <WavefrontPtxSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_programs.cu" />
    <!-- Wavefront CUDA compute kernels -> .obj (linked into optix_renderer.lib) -->
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels.cu" />
    <WavefrontObjSource Include="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_launch.cu" />
  </ItemGroup>

  <!-- ===================================================================== -->
  <!-- Compile optix_programs.cu -> optix_programs.ptx                       -->
  <!-- ===================================================================== -->
  <Target Name="CompileOptixPrograms"
          Condition="'$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          BeforeTargets="Build"
          Inputs="@(OptixSource)"
          Outputs="$(SolutionDir)gpu\optix\%(OptixSource.Filename).ptx">

    <Message Text="[OptiX] Compiling %(OptixSource.Filename).cu to PTX..." Importance="High" />

    <PropertyGroup>
      <NvccPath>$(CudaToolkitPath)\bin\nvcc.exe</NvccPath>
      <OptixInclude>$(OptixSdkPath)\include</OptixInclude>
      <CudaInclude>$(CudaToolkitPath)\include</CudaInclude>
      <OptixFlags>--ptx</OptixFlags>
      <OptixFlags>$(OptixFlags) -O3</OptixFlags>
      <OptixFlags>$(OptixFlags) --use_fast_math</OptixFlags>
      <OptixFlags>$(OptixFlags) --relocatable-device-code=true</OptixFlags>
      <OptixFlags>$(OptixFlags) -arch=sm_86</OptixFlags>
      <OptixFlags>$(OptixFlags) -I"$(OptixInclude)"</OptixFlags>
      <OptixFlags>$(OptixFlags) -I"$(CudaInclude)"</OptixFlags>
      <OptixFlags>$(OptixFlags) -I"$(MSBuildProjectDirectory)\..\gpu\optix"</OptixFlags>
      <OptixSourcePath>$(MSBuildProjectDirectory)\..\gpu\optix\%(OptixSource.Filename)%(OptixSource.Extension)</OptixSourcePath>
      <OptixOutput>$(MSBuildProjectDirectory)\..\gpu\optix\%(OptixSource.Filename).ptx</OptixOutput>
    </PropertyGroup>

    <Exec Command='"$(NvccPath)" $(OptixFlags) "$(OptixSourcePath)" -o "$(OptixOutput)"'
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />

    <Message Text="[OptiX] Generated PTX: $(OptixOutput)" Importance="High" />
  </Target>

  <!-- ===================================================================== -->
  <!-- Compile wavefront_programs.cu -> wavefront_programs.ptx               -->
  <!-- ===================================================================== -->
  <Target Name="CompileWavefrontPtx"
          Condition="'$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          BeforeTargets="Build"
          Inputs="@(WavefrontPtxSource)"
          Outputs="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_programs.ptx">

    <Message Text="[OptiX] Compiling wavefront_programs.cu to PTX..." Importance="High" />

    <PropertyGroup>
      <NvccPath>$(CudaToolkitPath)\bin\nvcc.exe</NvccPath>
      <WfPtxFlags>--ptx -O3 --use_fast_math --relocatable-device-code=true -arch=sm_86</WfPtxFlags>
      <WfPtxFlags>$(WfPtxFlags) -I"$(OptixSdkPath)\include"</WfPtxFlags>
      <WfPtxFlags>$(WfPtxFlags) -I"$(CudaToolkitPath)\include"</WfPtxFlags>
      <WfPtxFlags>$(WfPtxFlags) -I"$(MSBuildProjectDirectory)\..\gpu\optix"</WfPtxFlags>
      <WfPtxFlags>$(WfPtxFlags) -I"$(MSBuildProjectDirectory)\..\src\shared"</WfPtxFlags>
      <WfPtxOut>$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_programs.ptx</WfPtxOut>
    </PropertyGroup>

    <Exec Command='"$(NvccPath)" $(WfPtxFlags) "$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_programs.cu" -o "$(WfPtxOut)"'
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />

    <Message Text="[OptiX] Generated PTX: $(WfPtxOut)" Importance="High" />
  </Target>

  <!-- ===================================================================== -->
  <!-- Compile wavefront_kernels.cu + wavefront_launch.cu -> .obj            -->
  <!-- (linked into optix_renderer.lib via AdditionalDependencies)           -->
  <!-- ===================================================================== -->
  <Target Name="CompileWavefrontKernels"
          Condition="'$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          BeforeTargets="Lib"
          Inputs="@(WavefrontObjSource)"
          Outputs="$(MSBuildProjectDirectory)\..\gpu\optix\%(WavefrontObjSource.Filename).obj">

    <Message Text="[CUDA] Compiling %(WavefrontObjSource.Filename).cu to obj..." Importance="High" />

    <PropertyGroup>
      <NvccPath>$(CudaToolkitPath)\bin\nvcc.exe</NvccPath>
      <WfObjFlags>-c -O3 --use_fast_math --relocatable-device-code=true -arch=sm_86 --std=c++17</WfObjFlags>
      <WfObjFlags Condition="'$(Configuration)'=='Debug'">$(WfObjFlags) -Xcompiler /MDd</WfObjFlags>
      <WfObjFlags Condition="'$(Configuration)'=='Release'">$(WfObjFlags) -Xcompiler /MD</WfObjFlags>
      <WfObjFlags>$(WfObjFlags) -I"$(OptixSdkPath)\include"</WfObjFlags>
      <WfObjFlags>$(WfObjFlags) -I"$(CudaToolkitPath)\include"</WfObjFlags>
      <WfObjFlags>$(WfObjFlags) -I"$(MSBuildProjectDirectory)\..\gpu\optix"</WfObjFlags>
      <WfObjFlags>$(WfObjFlags) -I"$(MSBuildProjectDirectory)\..\src\shared"</WfObjFlags>
      <WfObjSrc>$(MSBuildProjectDirectory)\..\gpu\optix\%(WavefrontObjSource.Filename)%(WavefrontObjSource.Extension)</WfObjSrc>
      <WfObjOut>$(MSBuildProjectDirectory)\..\gpu\optix\%(WavefrontObjSource.Filename).obj</WfObjOut>
    </PropertyGroup>

    <Exec Command='"$(NvccPath)" $(WfObjFlags) "$(WfObjSrc)" -o "$(WfObjOut)"'
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />

    <Message Text="[CUDA] Compiled: $(WfObjOut)" Importance="High" />
  </Target>

  <!-- ===================================================================== -->
  <!-- Device-link wavefront .obj files -> wavefront_dlink.obj               -->
  <!-- Resolves __cudaRegisterLinkedBinary_* for the host linker.            -->
  <!-- This must run after both .cu -> .obj compiles and before Lib.         -->
  <!-- ===================================================================== -->
  <Target Name="DeviceLinkWavefront"
          Condition="'$(SolutionDir)' != '' and '$(MSBuildProjectName)' == 'optix_renderer'"
          AfterTargets="CompileWavefrontKernels"
          BeforeTargets="Lib">

    <Message Text="[CUDA] Device-linking wavefront objs -> wavefront_dlink.obj..." Importance="High" />

    <PropertyGroup>
      <NvccPath>$(CudaToolkitPath)\bin\nvcc.exe</NvccPath>
      <DlinkFlags>-dlink -arch=sm_86</DlinkFlags>
      <DlinkFlags Condition="'$(Configuration)'=='Debug'">$(DlinkFlags) -Xcompiler /MDd -G</DlinkFlags>
      <DlinkFlags Condition="'$(Configuration)'=='Release'">$(DlinkFlags) -Xcompiler /MD</DlinkFlags>
      <DlinkIn1>$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels.obj</DlinkIn1>
      <DlinkIn2>$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_launch.obj</DlinkIn2>
      <DlinkOut>$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_dlink.obj</DlinkOut>
    </PropertyGroup>

    <Exec Command='"$(NvccPath)" $(DlinkFlags) "$(DlinkIn1)" "$(DlinkIn2)" -o "$(DlinkOut)"'
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="false"
          ConsoleToMSBuild="true" />

    <Message Text="[CUDA] Device-linked: $(DlinkOut)" Importance="High" />
  </Target>

  <!-- ===================================================================== -->
  <!-- Clean OptiX outputs                                                    -->
  <!-- ===================================================================== -->
  <Target Name="CleanOptixPrograms" AfterTargets="Clean">
    <ItemGroup>
      <OptixPtxFiles Include="$(OptixOutputDir)\*.ptx" />
      <OptixObjFiles Include="$(OptixOutputDir)\wavefront_kernels.obj;$(OptixOutputDir)\wavefront_launch.obj;$(OptixOutputDir)\wavefront_dlink.obj" />
    </ItemGroup>
    <Delete Files="@(OptixPtxFiles);@(OptixObjFiles)" />
    <Message Text="[OptiX] Cleaned PTX and CUDA obj files" Importance="High" />
  </Target>

</Project>
