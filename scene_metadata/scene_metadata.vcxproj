<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{C3D4E5F6-A7B8-49C0-8D1E-2F3A4B5C6D7E}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>scene_metadata</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <!-- WholeProgramOptimization (LTCG) removed: this DLL links the whole
         cpu_renderer.lib (which contains a /GL-compiled object,
         stb_image_impl.obj - see scene_metadata_dll.cpp's own comment),
         and that combination reproducibly hit "fatal error LNK1103:
         debugging information corrupt" here too, the same class of MSVC
         LTCG+/GL linker fragility already worked around in
         tests/ray_tracer_tests.vcxproj and launcher/launcher.vcxproj. This
         DLL is a handful of trivial passthrough exports (see
         scene_metadata_dll.cpp) - there's no meaningful optimization to
         lose by dropping LTCG here. -->
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;_USRDLL;SCENE_METADATA_EXPORTS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- ..\src\shared - needed for rgb_spectrum_table_data.cpp's own
           unqualified #include "rgb_to_spectrum_table.h" (see this
           project's own ItemGroup comment on that ClCompile entry). -->
      <AdditionalIncludeDirectories>..\src\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;SCENE_METADATA_EXPORTS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- ..\src\shared - needed for rgb_spectrum_table_data.cpp's own
           unqualified #include "rgb_to_spectrum_table.h" (see this
           project's own ItemGroup comment on that ClCompile entry). -->
      <AdditionalIncludeDirectories>..\src\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="scene_metadata_dll.cpp" />
    <!-- RGBToSpectrumTable::sRGB()'s backing data. scene_metadata_dll.cpp
         links cpu_renderer.lib, which now (via camera.h's spectral render
         path, ray_color_spectral()) references RGBToSpectrumTable::sRGB()
         through RGBAlbedoSpectrum/RGBIlluminantSpectrum - even though that
         function is only ever called at runtime when that flag is passed,
         the symbol reference is unconditional at link time. Unlike
         launcher.exe/ray_tracer_tests.exe (which also link optix_renderer.lib,
         itself already providing this data), this DLL's link graph is just
         cpu_renderer.lib alone, so it needs its own copy - added here
         instead of to cpu_renderer.vcxproj to avoid a duplicate-symbol
         clash with optix_renderer.lib's own copy in the two consumers that
         link both libraries together. -->
    <ClCompile Include="..\src\data\rgb_spectrum_table_data.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\cpu_renderer\cpu_renderer.vcxproj">
      <Project>{5F2A8E6C-9B3F-4A1D-B7A7-2F9C9E2B4A11}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- Post-Build Event: Auto-deploy to RayTracer_Package, next to RayTracerGUI.exe -->
  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <PackageDir>$(SolutionDir)RayTracer_Package</PackageDir>
    </PropertyGroup>
    <MakeDir Directories="$(PackageDir)" Condition="!Exists('$(PackageDir)')" />
    <Message Text="[Post-Build] Copying scene_metadata.dll to RayTracer_Package..." Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PackageDir)\scene_metadata.dll" SkipUnchangedFiles="false" />
    <Message Text="[Post-Build] Deployed: $(PackageDir)\scene_metadata.dll" Importance="high" />
  </Target>
</Project>
