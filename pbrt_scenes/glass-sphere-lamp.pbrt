# @rt-category Test Scenes
# @rt-description A smooth glass sphere filling the frame, lit by a lamp above and behind it. Every light path is a mirror-like chain through the glass.
# @rt-performance Fast
# @rt-size 7.5
# glass-sphere-lamp.pbrt -- a smooth glass sphere filling the frame, lit by a lamp above and behind it, so the picture is the
# lamp's reflection and its refracted / internally reflected images: every path through the glass is a specular chain with no
# light sampling.
#
# What this guards: the wavefront backend picked reflect-vs-refract for smooth glass with Schlick's approximation fed the
# INCIDENT cosine, while the CPU and recursive backends (and pbrt) use the exact dielectric Fresnel. Schlick under-reflects for a
# ray leaving the glass (the inside-to-outside Fresnel climbs much faster toward the critical angle), so the light that reaches
# the lamp through two refractions and internal bounces was ~2x too bright: against a pbrt-v4 path-level reference the glass read
# 105.3% on the wavefront backend and 100.4% / 100.9% on CPU / recursive. All three now agree with the reference to ~1%.
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt  0 1.5 6    0 1.5 0    0 1 0
Camera "perspective" "float fov" [ 32 ]

Film "rgb" "integer xresolution" [ 200 ] "integer yresolution" [ 200 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

AttributeBegin
  Translate 0 5.5 -3
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 3 3 3 ]
  Shape "sphere" "float radius" [ 2 ]
AttributeEnd

AttributeBegin
  Translate 0 1.5 0
  Material "dielectric" "float eta" [ 1.5 ]
  Shape "sphere" "float radius" [ 1.5 ]
AttributeEnd
