# conductor-rgb-eta-k.pbrt -- exercises Material "conductor"'s explicit
# "rgb eta"/"rgb k" parameters and Material "coatedconductor"'s named-metal-
# spectrum resolution, real complex-IOR GGX models on both (previously both
# silently fell back to the flat-albedo fuzz-mirror/reflectance-only
# approximation - see docs/PBRT_SUPPORT.md). Neither is exercised by any
# other bundled scene (they all use conductor's own named spectrum, or give
# coatedconductor a flat reflectance only), so this is a completeness fix
# with no real motivating scene, unlike the DiffuseTransmission gap closed
# alongside it in the same pass.
#
# Left sphere: conductor bound to an explicit "rgb eta"/"rgb k" pair (a
# plausible gold-like metal, not calibrated to any real element) - should
# show a real tinted specular highlight, not the flat grey fuzz-mirror this
# fell back to before.
# Middle sphere: conductor bound to the real "metal-Au-eta"/"metal-Au-k"
# named spectrum, for comparison - real gold's own warm reflectance.
# Right sphere: coatedconductor bound to "metal-Ag-eta"/"metal-Ag-k" (silver)
# under a rough coat - previously this named spectrum was silently ignored
# for coatedconductor specifically, always falling back to the reflectance-
# only approximation regardless of what eta/k said.
#
# Original, not derived from any distributed scene, so it carries no
# licence constraints.

LookAt  1.5 1 5    1.5 0.5 0    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 640 ] "integer yresolution" [ 320 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.4 0.4 0.4 ]

AttributeBegin
  Translate 1.5 3.5 3
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 10 10 10 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -1 -1 0   1 -1 0   1 1 0   -1 1 0 ]
AttributeEnd

AttributeBegin
  Translate 0 0.5 0
  Material "conductor" "rgb eta" [ 0.2 0.9 1.4 ] "rgb k" [ 3.9 2.5 2.1 ] "float roughness" [ 0.15 ]
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd

AttributeBegin
  Translate 1.5 0.5 0
  Material "conductor" "spectrum eta" [ "metal-Au-eta" ] "spectrum k" [ "metal-Au-k" ] "float roughness" [ 0.15 ]
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd

AttributeBegin
  Translate 3 0.5 0
  Material "coatedconductor" "spectrum eta" [ "metal-Ag-eta" ] "spectrum k" [ "metal-Ag-k" ] "float roughness" [ 0.2 ]
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd
