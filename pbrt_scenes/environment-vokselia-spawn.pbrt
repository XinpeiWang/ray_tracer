# environment-vokselia-spawn.pbrt -- migration of the native "H11 Vokselia Spawn" environment scene (scenes_mesh_gallery.h's build_*()
# + its GPU twin in scene_builder_mesh_gallery.h) to a pbrt-backed scene. Generated, not retyped:
# a one-off script ported load_obj_mtl()'s per-material rules (mesh_mtl.h) to explicit pbrt directives.
#
# The mesh is models/vokselia_spawn.obj, named once per .mtl material as Shape "plymesh" "file.obj#material"
# (ply_mesh.h's OBJ group paths), so the multi-megabyte asset stays where it is. Per material: Ke -> an
# area light; illum 7 (or illum 4/6 with a real Tf and no map_Kd) -> dielectric ("rgb tf" is the .mtl
# transmission filter); illum 2/3 with a real Ks -> conductor; map_Kd -> a diffuse imagemap; else Kd;
# map_Bump -> a displacement texture (a float imagemap for a grayscale bump, a spectrum one for a
# tangent-space normal map); map_d -> the Shape's alpha cutout. Faces whose material the .mtl does not
# define use the native scene's fallback colour.
#
# Materials: textured=99 (of 99 shapes)
# Requires models/vokselia_spawn.obj and models/vokselia_spawn_textures/ (registry requires_files=true).

LookAt  4.5 0.9 4.5    0 0.25 0    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 100 ]

WorldBegin

# Flat sky = the native scene's constant sky_light colour.
LightSource "infinite" "rgb L" [ 0.5 0.6 0.8 ]

Texture "c0" "spectrum" "imagemap" "string filename" [ "../models/vokselia_spawn_textures/vokselia_spawn.png" ]

# The native loader applied x*scale + offset: Translate then Scale.
AttributeBegin
  Translate 0 0 0

  AttributeBegin
    # Stone
    Material "diffuse" "texture reflectance" [ "c0" ]
    Shape "plymesh" "string filename" [ "../models/vokselia_spawn.obj#Stone" ]
  AttributeEnd

  AttributeBegin
    # Grass
    Material "diffuse" "texture reflectance" [ "c0" ]
    Shape "plymesh" "string filename" [ "../models/vokselia_spawn.obj#Grass" ]
  AttributeEnd

  AttributeBegin
