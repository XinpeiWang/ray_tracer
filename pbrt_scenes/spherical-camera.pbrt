# spherical-camera.pbrt -- exercises pbrt-v4's "spherical" camera
# (equal-area concentric-octahedral mapping). No bundled example scene used
# anything but "perspective"/"orthographic" before this one. Positioned at
# the centre of an enclosed room rather than outside looking in - unlike
# every rectilinear camera in this folder, a spherical camera's whole point
# is capturing every direction at once, so it needs to actually be
# surrounded by geometry to demonstrate that instead of framing one wall.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 278    278 278 279    0 1 0
Camera "spherical" "string mapping" [ "equalarea" ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 18 15 8 ]
  Translate 278 554 278
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -65 0 -52   65 0 -52   65 0 52   -65 0 52 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   555 0 0   555 0 555   0 0 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 555 555   0 555 555 ]
Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   0 0 555   0 555 555   0 555 0 ]

Material "conductor" "float roughness" [ 0.1 ]
AttributeBegin
  Translate 180 90 180
  Shape "sphere" "float radius" [ 80 ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.8 0.7 0.2 ]
AttributeBegin
  Translate 400 90 400
  Shape "sphere" "float radius" [ 80 ]
AttributeEnd
