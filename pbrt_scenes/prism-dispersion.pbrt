# @rt-size 700
# prism-dispersion.pbrt -- migration of the native "B23 Glass Prism
# Dispersion" demo scene (src/TheRestOfYourLife/scenes_materials.h's
# build_prism_dispersion()) to a pbrt-backed scene, part of this project's
# GPU scene-construction-duplication elimination.
#
# Uses Material "dielectric" with a new "float abbenumber" parameter - NOT
# real pbrt-v4 syntax (pbrt-v4's own genuine spectral dispersion is a full
# "spectrum eta" per-wavelength curve, which this loader doesn't integrate -
# see Material::abbeNumber's own comment, src/shared/pbrt_flatten.h, for the
# full rationale). Unlike Principled/NormalizedFresnel (this loader's first
# two non-standard extensions, each a whole new Material kind), this one
# attaches a single new optional parameter to the EXISTING, already-fully-
# pbrt-v4-standard "dielectric" material kind - a smaller, narrower
# extension. Wired to this project's own already-implemented, already-
# working dielectric::make_dispersive()/rough_dielectric::make_dispersive()
# (CPU) and the exact same Cauchy-coefficient derivation
# (CauchyCoefficientsFromAbbe(), src/shared/fresnel.h) GPU's own
# add_dispersive_dielectric()/add_dispersive_rough_dielectric() already use -
# full fidelity on all 3 backends (CPU/GPU-wavefront: real continuous
# spectral integration; GPU-recursive: the same already-documented
# 3-representative-wavelength approximation native always had - see this
# scene's own registry description). Only visible under --spectral
# rendering - under the default flat-RGB path this renders as an ordinary
# (non-dispersive-looking) glass wedge, same as native.
#
# Geometry: a real triangular prism (cross-section in the Y-Z plane, apex
# up: A(0,0,0) B(0,0,140) C(0,121,70), extruded along +X by 150), 3
# rectangular side quads + 2 triangular end caps sharing one trianglemesh,
# plus a white catcher screen - byte-for-byte the same coordinates as
# native's own build_prism_dispersion_geometry() (scenes_materials.h),
# including that function's own hand-derived outward-normal winding.
# Deliberately not a Cornell box (colored walls would tint/muddy a pure-
# white dispersion fan) - black background, matching native's own bg=(0,0,0).
#
# Light: LightSource "distant" (a real pbrt-v4 light type, already fully
# supported) - "from"/"to" chosen so from-to equals native's own
# add_distant() direction-toward-the-light vector (0, 0.06, -1.0) exactly
# (see pbrt_flatten.h's own "distant" parsing: dir = normalize(from - to),
# the same convention pbrt-v4's real DistantLight::Create uses). "scale"
# reproduces native's own intensity multiplier (3.0).
#
# Original, not derived from any distributed scene, so it carries no
# licence constraints.

LookAt  75 60 -400    75 75 250    0 1 0
Camera "perspective" "float fov" [ 30 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

LightSource "distant" "point3 from" [ 0 0.06 -1.0 ] "point3 to" [ 0 0 0 ]
  "rgb L" [ 1 1 1 ] "float scale" [ 3.0 ]

# ---------------------------------------------------------------- prism
Material "dielectric" "float eta" [ 1.52 ] "float abbenumber" [ 59.0 ]

# base (z=0..140 side, y=0): Q=A u=depth v=(B-A)
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   150 0 0   150 0 140   0 0 140 ]
# exit slant (toward +z): Q=B u=depth v=(C-B)
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 140   150 0 140   150 121 70   0 121 70 ]
# entry slant (toward -z): Q=C u=depth v=(A-C)
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 121 70   150 121 70   150 0 0   0 0 0 ]
# x=0 end cap (forward winding A,B,C -> outward -X)
Shape "trianglemesh" "integer indices" [ 0 1 2 ]
  "point3 P" [ 0 0 0   0 0 140   0 121 70 ]
# x=150 end cap (reversed winding A',C',B' -> outward +X)
Shape "trianglemesh" "integer indices" [ 0 1 2 ]
  "point3 P" [ 150 0 0   150 121 70   150 0 140 ]

# ---------------------------------------------------------------- catcher screen
Material "diffuse" "rgb reflectance" [ 0.9 0.9 0.9 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -300 -300 600   300 -300 600   300 400 600   -300 400 600 ]
