# rgbgrid-medium.pbrt -- exercises MakeNamedMedium "rgbgrid" (a 6x6x6 flat
# "rgb sigma_s" voxel grid, src/shared/rgb_grid_medium.h) plus
# MediumInterface, both loader-side (pbrt_scene.h/pbrt_flatten.h's
# de-interleave of the flat RGB-triple array into per-channel vectors) and
# both render backends (CPU's rgb_grid_medium_hittable, GPU's
# MaterialType::RgbGridMedium).
#
# Like cloud-medium.pbrt, the medium is declared inside its own
# Translate+Scale block so the CTM captured at MakeNamedMedium time (not an
# axis-aligned box picked by hand) is what places it. The voxel data is
# three overlapping Gaussian blobs, one centered per channel, so the render
# should show a soft coloured "nebula" rather than a flat tint.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  40 260 -350    40 290 340    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 500 ] "integer yresolution" [ 500 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.6 0.7 0.9 ]

Material "diffuse" "rgb reflectance" [ 0.5 0.5 0.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -400 0 -400   900 0 -400   900 0 900   -400 0 900 ]

Material "conductor" "float roughness" [ 0.05 ]
AttributeBegin
  Translate -150 60 -50
  Shape "sphere" "float radius" [ 60 ]
AttributeEnd

# Medium-space bounds default to the unit cube [0,1]^3; the Translate+Scale
# below places/sizes that cube in world space - the CTM at this exact point
# is what gets captured. nx=ny=nz=6, so "rgb sigma_s" holds 6*6*6=216 RGB
# triples (648 numbers), one per voxel, in x-fastest, then y, then z order
# (matches RGBGridMediumData<T>::build()'s own indexing).
AttributeBegin
  Translate -50 200 250
  Scale 180 180 180
  MakeNamedMedium "nebula" "string type" [ "rgbgrid" ]
    "integer nx" [ 6 ] "integer ny" [ 6 ] "integer nz" [ 6 ]
    "float g" [ 0.2 ]
    "rgb sigma_s" [
    0.0243 0.0011 0.0021 0.0378 0.0045 0.0064 0.0338 0.0109 0.0111
    0.0174 0.0152 0.0111 0.0051 0.0122 0.0064 0.0009 0.0056 0.0021
    0.0737 0.0023 0.0105 0.1149 0.0098 0.0318 0.1028 0.0237 0.0555
    0.0528 0.0331 0.0555 0.0156 0.0265 0.0318 0.0026 0.0122 0.0105
