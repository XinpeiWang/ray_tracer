# cornell-conductor.pbrt -- migration of the native "B4 Cornell Conductor"
# demo scene (src/TheRestOfYourLife/scenes_materials.h's build_cornell_conductor(),
# gpu/optix/scene_builder.cpp's build_cornell_conductor_gpu()) to a
# pbrt-backed scene, part of this project's GPU scene-construction-
# duplication elimination (pilot batch).
#
# Walls/light are IDENTICAL to cornell-box-native.pbrt (both read from the
# same src/shared/cornell_box_data.h at the C++ level) - see that file's own
# header comment for the Q,u,v -> P0..P3 quad convention and the box-face
# algebra this reuses verbatim, just with conductor materials instead of
# lambertian/dielectric on the box/sphere.
#
# Gold sphere and aluminium box eta/k are transcribed exactly from
# src/shared/conductor_data.h's kConductorAu/kConductorAl (pbrt-v4's own
# Au/Al spectral tables, RGB-sampled at 630/532/467nm) via "rgb eta"/"rgb k"
# rather than "spectrum eta" "metal-Au-eta" etc. - the named spectrum path
# resamples pbrt's full spectral curve through this renderer's own spectral
# pipeline, which need not agree channel-for-channel with conductor_data.h's
# already-RGB-sampled constants; explicit "rgb eta"/"rgb k" is the only way
# to guarantee the exact same numbers both backends already use natively.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

# Flat background (native CameraConfig bg = 0.05 0.055 0.07)
LightSource "infinite" "rgb L" [ 0.05 0.055 0.07 ]

# ---------------------------------------------------------------- light
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 15 15 15 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 213 554 227   343 554 227   343 554 332   213 554 332 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 555 555   555 555 555 ]

# ---------------------------------------------------------------- contents
# Polished aluminium box (kConductorAl, roughness 0.05) - same geometry as
# cornell-box-native.pbrt's own white box.
Material "conductor" "rgb eta" [ 1.357 0.884 0.669 ] "rgb k" [ 7.588 6.470 5.690 ] "float roughness" [ 0.05 ]
AttributeBegin
  Translate 265 0 295
  Rotate 15 0 1 0
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 165   165 0 165   165 330 165   0 330 165 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 165   165 0 0   165 330 0   165 330 165 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 0   0 0 0   0 330 0   165 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   0 0 165   0 330 165   0 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 330 165   165 330 165   165 330 0   0 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   165 0 0   165 0 165   0 0 165 ]
AttributeEnd

# Polished gold sphere (kConductorAu, roughness 0.1)
Material "conductor" "rgb eta" [ 0.184 0.457 1.354 ] "rgb k" [ 3.070 2.408 1.818 ] "float roughness" [ 0.1 ]
AttributeBegin
  Translate 190 90 190
  Shape "sphere" "float radius" [ 90 ]
AttributeEnd
