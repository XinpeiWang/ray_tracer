# cornell-goniometric.pbrt -- migration of the native "C5 Goniometric Light
# Cornell" demo scene (src/TheRestOfYourLife/scenes_advanced.h's
# build_goniometric_light_scene()/build_goniometric_punct()) to a pbrt-backed
# scene, part of this project's GPU scene-construction-duplication
# elimination.
#
# Walls/spheres are IDENTICAL to cornell-spotlight.pbrt (both share
# cornell_walls_no_light()) - see that file's own header comment.
#
# Goniometric profile image: this loader's GoniometricLight requires a
# SQUARE image (pbrt_cpu_builder.h's own comment, matching real pbrt-v4's
# GoniometricLight::Create) - the native scene's own profile is 16x8
# (non-square), which would silently fall back to a uniform isotropic
# profile here. cornell-goniometric-profile.bmp instead reproduces the
# SAME v-only gradient formula (0.2 + 0.8*(v/N)) at 16x16 - since the
# native profile varies only by row (v), not by column (u), a finer square
# grid samples that identical gradient, just at higher angular resolution.
# Pre-encoded with a gamma-2.2 power curve (byte = 255*value^(1/2.2)) so
# rtw_image's/stb_image's default gamma-2.2 LDR decode (both backends -
# see rtw_image::load()'s own comment) reconstructs the intended LINEAR
# 0.2..1.0 values exactly, not a gamma-darkened version of them. .bmp, not
# .png, matching this repo's own uv-checker.bmp/nonsquare-checker.bmp
# convention (this loader's own hand-authored pbrt-scene assets use .bmp
# specifically so .gitignore's blanket "*.png" render-output rule doesn't
# swallow them - see .gitignore's own comment on those two files).
#
# Position/rotation: identity world-to-light (pure Translate, no Rotate) -
# matches the native scene's own id[9] identity matrix exactly.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints. cornell-goniometric-profile.png is likewise hand-generated.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

AttributeBegin
  Translate 278 520 278
  LightSource "goniometric" "rgb I" [ 1.0 0.9 0.7 ] "float scale" [ 600000.0 ]
    "string filename" [ "cornell-goniometric-profile.bmp" ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 555 555   555 555 555 ]

# ---------------------------------------------------------------- contents
Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
AttributeBegin
  Translate 190 90 190
  Shape "sphere" "float radius" [ 90 ]
AttributeEnd

Material "conductor" "rgb reflectance" [ 0.8 0.8 0.9 ] "float roughness" [ 0.1 ]
AttributeBegin
  Translate 370 120 380
  Shape "sphere" "float radius" [ 120 ]
AttributeEnd
