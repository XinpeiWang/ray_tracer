# @rt-category Test Scenes
# @rt-description A glowing paraboloid seen from the side, lit by nothing else. --lightpath, --bdpt and the path tracer must read the same.
# @rt-gpu no
# @rt-performance Fast
# lightpath-visible-paraboloid-light.pbrt -- a paraboloid (seen from the side) that is itself the picture, lit by nothing else: --lightpath, --bdpt and the path tracer must read the same.
# See lightpath-visible-sphere-light.pbrt.
#
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt 0 0 6  0 0 0  0 1 0
Camera "perspective" "float fov" [ 30 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 16 ]
WorldBegin

AttributeBegin
  Rotate 90 1 0 0
  Translate 0 0 -0.8
  AreaLightSource "diffuse" "rgb L" [ 4 4 4 ]
  Shape "paraboloid" "float radius" [ 1 ] "float zmin" [ 0 ] "float zmax" [ 1.6 ]
AttributeEnd
