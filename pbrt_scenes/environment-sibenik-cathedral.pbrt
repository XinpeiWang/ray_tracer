# environment-sibenik-cathedral.pbrt -- migration of the native "H6 Sibenik Cathedral" environment scene (scenes_mesh_gallery.h's build_*()
# + its GPU twin) to a pbrt-backed scene. Generated by scripts/gen_environment_scenes.py - rerun it
# rather than hand-editing: it ports load_obj_mtl()'s per-material rules (mesh_mtl.h) to explicit pbrt directives.
#
# The mesh is models/sibenik_cathedral.obj, named once per .mtl material as Shape "plymesh" "file.obj#material"
# (ply_mesh.h's OBJ group paths), so the multi-megabyte asset stays where it is. Per material: Ke -> an
# area light; illum 7 (or illum 4/6 with a real Tf and no map_Kd) -> dielectric ("rgb tf" is the .mtl
# transmission filter); illum 2/3 with a real Ks -> conductor; map_Kd -> a diffuse imagemap; else Kd;
# map_Bump -> a displacement texture (a float imagemap for a grayscale bump, a spectrum one for a
# tangent-space normal map); map_d -> the Shape's alpha cutout. Faces whose material the .mtl does not
# define use the native scene's fallback colour.
#
# Materials: glass=4, metal=1, textured=8, flat=2, bump=5 (of 15 shapes)
# Requires models/sibenik_cathedral.obj and models/sibenik_cathedral_textures/ (registry requires_files=true).

LookAt  -15 1.7 0    15 5 0    0 1 0
Camera "perspective" "float fov" [ 60 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 400 ]

# GPU only: the native scene raised the shadow-ray origin offset from 0.01 to 0.5 - this cathedral's
# dense stone tracery false-occludes most sky shadow rays at 0.01 (GPU ~24% of CPU brightness, measured).
Integrator "volpath" "float shadowrayepsilon" [ 0.5 ]

WorldBegin

# Flat sky = the native scene's constant sky_light colour.
LightSource "infinite" "rgb L" [ 4.5 4.8 5.2 ]

Texture "c0" "spectrum" "imagemap" "string filename" [ "../models/sibenik_cathedral_textures/kamen.png" ]
Texture "f1" "float" "imagemap" "string filename" [ "../models/sibenik_cathedral_textures/kamen-bump.png" ]
Texture "c2" "spectrum" "imagemap" "string filename" [ "../models/sibenik_cathedral_textures/KAMEN-stup.png" ]
Texture "c3" "spectrum" "imagemap" "string filename" [ "../models/sibenik_cathedral_textures/mramor6x6.png" ]
Texture "f4" "float" "imagemap" "string filename" [ "../models/sibenik_cathedral_textures/mramor6x6-bump.png" ]

# The native loader applied x*scale + offset: Translate then Scale.
AttributeBegin
  Translate 0 15.3123 0

  AttributeBegin
    # sprljci
    Material "diffuse" "rgb reflectance" [ 0.784314 0.784314 0.784314 ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#sprljci" ]
  AttributeEnd

  AttributeBegin
    # staklo
    Material "dielectric" "float eta" [ 1 ] "rgb tf" [ 0.5 0.5 0.5 ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#staklo" ]
  AttributeEnd

  AttributeBegin
    # kamen_zid
    Material "diffuse" "texture reflectance" [ "c0" ] "texture displacement" [ "f1" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#kamen_zid" ]
  AttributeEnd

  AttributeBegin
    # stupovi
    Material "diffuse" "texture reflectance" [ "c2" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#stupovi" ]
  AttributeEnd

  AttributeBegin
    # pod
    Material "diffuse" "texture reflectance" [ "c3" ] "texture displacement" [ "f4" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#pod" ]
  AttributeEnd

  AttributeBegin
    # pod_tepih
    Material "diffuse" "rgb reflectance" [ 0.546274 0.219608 0.183922 ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#pod_tepih" ]
  AttributeEnd

  AttributeBegin
    # pod_rub
    Material "diffuse" "texture reflectance" [ "c0" ] "texture displacement" [ "f1" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#pod_rub" ]
  AttributeEnd

  AttributeBegin
    # kamen_zid_prozor
    Material "diffuse" "texture reflectance" [ "c0" ] "texture displacement" [ "f1" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#kamen_zid_prozor" ]
  AttributeEnd

  AttributeBegin
    # zid_vani
    Material "diffuse" "texture reflectance" [ "c0" ] "texture displacement" [ "f1" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#zid_vani" ]
  AttributeEnd

  AttributeBegin
    # kamen_zid_parapet
    Material "diffuse" "texture reflectance" [ "c2" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#kamen_zid_parapet" ]
  AttributeEnd

  AttributeBegin
    # staklo_crveno
    Material "conductor" "rgb reflectance" [ 0.441176 0.103922 0.04902 ] "float roughness" [ 0.0880450906 ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#staklo_crveno" ]
  AttributeEnd

  AttributeBegin
    # rozeta
    Material "diffuse" "texture reflectance" [ "c2" ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#rozeta" ]
  AttributeEnd

  AttributeBegin
    # staklo_zeleno
    Material "dielectric" "float eta" [ 1 ] "rgb tf" [ 0.066667 0.631373 0.07451 ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#staklo_zeleno" ]
  AttributeEnd

  AttributeBegin
    # staklo_plavo
    Material "dielectric" "float eta" [ 1 ] "rgb tf" [ 0.082353 0.145098 0.784314 ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#staklo_plavo" ]
  AttributeEnd

  AttributeBegin
    # staklo_zuto
    Material "dielectric" "float eta" [ 1 ] "rgb tf" [ 1 0.890196 0.007843 ]
    Shape "plymesh" "string filename" [ "../models/sibenik_cathedral.obj#staklo_zuto" ]
  AttributeEnd
AttributeEnd
