# cone-paraboloid-gallery.pbrt -- exercises Shape "cone"/Shape "paraboloid"
# (this codebase's own pbrt-v3-compatibility extension, NOT part of real
# pbrt-v4 - see docs/PBRT_SUPPORT.md), including both as an AreaLightSource
# emitter and with a MediumInterface fog boundary. CPU-only: GPU (both
# backends) warns and drops any cone/paraboloid shape entirely - render
# this scene with --cpu.
#
#  - Cone 1 (x=0): plain diffuse cone, upright, apex up - base shape.
#  - Paraboloid 1 (x=3): plain diffuse paraboloid, upright, rim up - base
#    shape (visibly different silhouette from the cone - curved profile,
#    not a straight taper).
#  - Cone 2 (x=6): AreaLightSource "diffuse" instead of a normal material -
#    should glow, not just sit lit by the scene's other lights.
#  - Paraboloid 2 (x=9): MediumInterface fog boundary, near-invisible
#    "dielectric" eta~1.001 shell (same convention as cylinder-medium.pbrt -
#    an opaque material would absorb the ray before it ever reaches the
#    medium's own scattering), oriented with its open rim (zmax) facing the
#    camera so incoming rays enter the medium through the open end, not the
#    solid paraboloid surface - should render as a soft hazy bowl-shaped
#    volume, not an invisible no-op shape.
#
# Original, not derived from any distributed scene, so it carries no
# licence constraints.

LookAt  4.5 2.5 16    4.5 1 0    0 1 0
Camera "perspective" "float fov" [ 42 ]

Film "rgb" "integer xresolution" [ 900 ] "integer yresolution" [ 360 ]
Sampler "halton" "integer pixelsamples" [ 96 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.35 0.35 0.4 ]

Material "diffuse" "rgb reflectance" [ 0.5 0.5 0.55 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -3 0 -4   12 0 -4   12 0 4   -3 0 4 ]

AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.8 0.3 0.2 ]
  Translate 0 0 0
  Rotate -90 1 0 0
  Shape "cone" "float radius" [ 1 ] "float height" [ 2 ]
AttributeEnd

AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.2 0.5 0.8 ]
  Translate 3 0 0
  Rotate -90 1 0 0
  Shape "paraboloid" "float radius" [ 1 ] "float zmin" [ 0 ] "float zmax" [ 1.6 ]
AttributeEnd

AttributeBegin
  Translate 6 1.3 0
  Rotate -90 1 0 0
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 10 10 10 ]
  Shape "cone" "float radius" [ 0.9 ] "float height" [ 1.6 ]
AttributeEnd

MakeNamedMedium "cone-fog" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0.3 0.3 0.3 ] "rgb sigma_s" [ 2.0 2.0 2.0 ]

AttributeBegin
  Translate 9 1 -0.5
  Material "dielectric" "float eta" [ 1.001 ]
  MediumInterface "cone-fog" ""
  Shape "paraboloid" "float radius" [ 1 ] "float zmin" [ 0 ] "float zmax" [ 1.6 ]
AttributeEnd
