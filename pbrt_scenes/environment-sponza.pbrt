# environment-sponza.pbrt -- migration of the native "H1 Crytek Sponza" environment scene (scenes_mesh_gallery.h's build_*()
# + its GPU twin) to a pbrt-backed scene. Generated by scripts/gen_environment_scenes.py - rerun it
# rather than hand-editing: it ports load_obj_mtl()'s per-material rules (mesh_mtl.h) to explicit pbrt directives.
#
# The mesh is models/sponza.obj, named once per .mtl material as Shape "plymesh" "file.obj#material"
# (ply_mesh.h's OBJ group paths), so the multi-megabyte asset stays where it is. Per material: Ke -> an
# area light; illum 7 (or illum 4/6 with a real Tf and no map_Kd) -> dielectric ("rgb tf" is the .mtl
# transmission filter); illum 2/3 with a real Ks -> conductor; map_Kd -> a diffuse imagemap; else Kd;
# map_Bump -> a displacement texture (a float imagemap for a grayscale bump, a spectrum one for a
# tangent-space normal map); map_d -> the Shape's alpha cutout. Faces whose material the .mtl does not
# define use the native scene's fallback colour.
#
# Materials: textured=24, flat=1, bump=10, alpha=3 (of 25 shapes)
# Requires models/sponza.obj and models/sponza_textures/ (registry requires_files=true).

LookAt  -800 300 0    800 300 0    0 1 0
Camera "perspective" "float fov" [ 70 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 150 ]

WorldBegin

# Flat sky = the native scene's constant sky_light colour.
LightSource "infinite" "rgb L" [ 1.3 1.56 1.9 ]

Texture "c0" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_thorn_diff.png" ]
Texture "f1" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_thorn_bump.png" ]
Texture "f1s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f1" ]
Texture "f2" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_thorn_mask.png" ]
Texture "c3" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/vase_plant.png" ]
Texture "f4" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/vase_plant_mask.png" ]
Texture "c5" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/vase_round.png" ]
Texture "f6" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/vase_round_bump.png" ]
Texture "f6s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f6" ]
Texture "c7" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/background.png" ]
Texture "f8" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/background_bump.png" ]
Texture "f8s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f8" ]
Texture "c9" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/spnza_bricks_a_diff.png" ]
Texture "f10" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/spnza_bricks_a_bump.png" ]
Texture "f10s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f10" ]
Texture "c11" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_arch_diff.png" ]
Texture "c12" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_ceiling_a_diff.png" ]
Texture "c13" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_column_a_diff.png" ]
Texture "f14" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_column_a_bump.png" ]
Texture "f14s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f14" ]
Texture "c15" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_floor_a_diff.png" ]
Texture "c16" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_column_c_diff.png" ]
Texture "f17" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_column_c_bump.png" ]
Texture "f17s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f17" ]
Texture "c18" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_details_diff.png" ]
Texture "c19" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_column_b_diff.png" ]
Texture "f20" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_column_b_bump.png" ]
Texture "f20s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f20" ]
Texture "c21" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_flagpole_diff.png" ]
Texture "c22" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_fabric_green_diff.png" ]
Texture "c23" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_fabric_blue_diff.png" ]
Texture "c24" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_fabric_diff.png" ]
Texture "c25" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_curtain_blue_diff.png" ]
Texture "c26" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_curtain_diff.png" ]
Texture "c27" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_curtain_green_diff.png" ]
Texture "c28" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/chain_texture.png" ]
Texture "f29" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/chain_texture_bump.png" ]
Texture "f29s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f29" ]
Texture "f30" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/chain_texture_mask.png" ]
Texture "c31" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/vase_hanging.png" ]
Texture "c32" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/vase_dif.png" ]
Texture "f33" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/vase_bump.png" ]
Texture "f33s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f33" ]
Texture "c34" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/lion.png" ]
Texture "f35" "float" "imagemap" "string filename" [ "../models/sponza_textures/textures/lion_bump.png" ]
Texture "f35s" "float" "scale" "float scale" [ 1.39109176 ] "texture tex" [ "f35" ]
Texture "c36" "spectrum" "imagemap" "string filename" [ "../models/sponza_textures/textures/sponza_roof_diff.png" ]

# The native loader applied x*scale + offset: Translate then Scale.
AttributeBegin
  Translate 60.52 126.44 38.69

  AttributeBegin
    # leaf
    Material "diffuse" "texture reflectance" [ "c0" ] "texture displacement" [ "f1s" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#leaf" ] "texture alpha" [ "f2" ]
  AttributeEnd

  AttributeBegin
    # Material__57
    Material "diffuse" "texture reflectance" [ "c3" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#Material__57" ] "texture alpha" [ "f4" ]
  AttributeEnd

  AttributeBegin
    # vase_round
    Material "diffuse" "texture reflectance" [ "c5" ] "texture displacement" [ "f6s" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#vase_round" ]
  AttributeEnd

  AttributeBegin
    # Material__298
    Material "diffuse" "texture reflectance" [ "c7" ] "texture displacement" [ "f8s" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#Material__298" ]
