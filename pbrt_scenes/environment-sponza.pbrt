    Material "diffuse" "texture reflectance" [ "c15" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#floor" ]
  AttributeEnd

  AttributeBegin
    # column_c
    Material "diffuse" "texture reflectance" [ "c16" ] "texture displacement" [ "f17s" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#column_c" ]
  AttributeEnd

  AttributeBegin
    # details
    Material "diffuse" "texture reflectance" [ "c18" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#details" ]
  AttributeEnd

  AttributeBegin
    # column_b
    Material "diffuse" "texture reflectance" [ "c19" ] "texture displacement" [ "f20s" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#column_b" ]
  AttributeEnd

  AttributeBegin
    # Material__47
    Material "diffuse" "rgb reflectance" [ 0.588 0.588 0.588 ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#Material__47" ]
  AttributeEnd

  AttributeBegin
    # flagpole
    Material "diffuse" "texture reflectance" [ "c21" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#flagpole" ]
  AttributeEnd

  AttributeBegin
    # fabric_e
    Material "diffuse" "texture reflectance" [ "c22" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#fabric_e" ]
  AttributeEnd

  AttributeBegin
    # fabric_d
    Material "diffuse" "texture reflectance" [ "c23" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#fabric_d" ]
  AttributeEnd

  AttributeBegin
    # fabric_a
    Material "diffuse" "texture reflectance" [ "c24" ]
    Shape "plymesh" "string filename" [ "../models/sponza.obj#fabric_a" ]
  AttributeEnd

  AttributeBegin
