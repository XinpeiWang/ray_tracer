# curve-fibers-scene.pbrt -- migration of the native "F4 Curve Fibers" demo
# scene (src/TheRestOfYourLife/scenes_advanced.h's build_curve_fibers_scene())
# to a pbrt-backed scene, part of this project's GPU scene-construction-
# duplication elimination.
#
# Shape "curve": real pbrt-v4 cubic Bezier hair/fiber strands
# (CurveShape<double> on CPU, tessellated into tapered bilinear-patch tubes
# on GPU - src/shared/curve_tessellate.h, matching pbrt-v4's own real GPU
# strategy of dicing curves rather than a native curve-intersection
# program). This loader's own bundled pbrt_scenes/curve-tuft.pbrt example
# already exercises the exact same Fibonacci-disk-placement + deterministic
# hash01 formula this native scene uses (its own header comment says so
# directly), just at a smaller strand count (24) with flat, uncolored
# diffuse. This file instead reproduces F4's OWN full parameters exactly:
# 70 strands, disk_radius=1.4, the same 5-tone hair palette cycling by
# index, tapered width0=0.045/width1=0.006. All 70 strands' control points
# were computed once (see this migration's own notes) from native's exact
# formula (hash01(i,salt), Fibonacci sunflower disk placement, windswept
# +X lean) and transcribed verbatim below - fully deterministic, no RNG
# anywhere, so this is byte-for-byte the same geometry native builds.
#
# Checker ground: this loader's real pbrt-v4 3D "checkerboard" "integer
# dimension" [3] support (pbrt_scenes/checkered-spheres.pbrt's own header
# comment) reproduces native's checker_texture(0.8, ...) exactly via
# `Scale 0.8 0.8 0.8` before the Texture directive - same convention as F2
# (Triangle Mesh), which shares this exact ground.
#
# Flat background: native's own CameraConfig row carries a dark flat
# background (0.04, 0.045, 0.06), reproduced via LightSource "infinite"
# (this loader's wire_pbrt_backed_scene() hardcodes black otherwise).
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  0 2.0 6.5    0 0.7 0    0 1 0
Camera "perspective" "float fov" [ 38 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 150 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.04 0.045 0.06 ]

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 6 6 6 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -2.5 4.0 -2.5   2.5 4.0 -2.5   2.5 4.0 2.5   -2.5 4.0 2.5 ]
AttributeEnd

AttributeBegin
  Scale 0.8 0.8 0.8
  Texture "ground-checker" "spectrum" "checkerboard" "integer dimension" [ 3 ]
    "rgb tex1" [ 0.15 0.15 0.15 ] "rgb tex2" [ 0.85 0.85 0.85 ]
AttributeEnd
Material "diffuse" "texture reflectance" [ "ground-checker" ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

# 70 strands, Fibonacci-disk placement, 5-tone palette cycling by index -
# see this file's own header comment.
