# cylinder-medium.pbrt -- exercises MediumInterface on Shape "cylinder",
# now real on GPU (both backends): the cylinder's own entry/exit roots are
# recomputed for Beer-Lambert free-path sampling through a homogeneous fog,
# same technique as MaterialType::Medium's pre-existing sphere support -
# previously GPU silently dropped the medium entirely, rendering the
# cylinder as ordinary invisible/no-op geometry instead of a foggy tube
# (see docs/PBRT_SUPPORT.md's disk/cylinder entry). Disk stays unsupported
# on purpose - a zero-thickness plane has no "inside" volume for a
# homogeneous medium's entry/exit pair to bound.
#
# A dense, absorbing/scattering fog cylinder standing between the camera and
# a bright area light - CPU and both GPU backends should now render the
# SAME hazy, softly-lit tube silhouette (not an invisible one).
#
# Original, not derived from any distributed scene, so it carries no
# licence constraints.

LookAt  0 2 8    0 1 0    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 400 ] "integer yresolution" [ 300 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

AttributeBegin
  Translate 0 5 -2
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 15 15 15 ]
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd

MakeNamedMedium "fog" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0.3 0.3 0.3 ] "rgb sigma_s" [ 2.0 2.0 2.0 ]

# The cylinder itself is still added to the scene separately with its own
# material (matching the homogeneous-medium "shell + fog inside" convention
# - see cloud-medium.pbrt's identical comment), so it needs an explicitly
# near-invisible one (eta~1: negligible refraction/reflection) rather than
# an opaque material - otherwise it renders as a solid black shell that
# absorbs the ray before it ever reaches the medium's own scattering.
AttributeBegin
  Translate -2 1 0
  Rotate 90 0 1 0
  Material "dielectric" "float eta" [ 1.001 ]
  MediumInterface "fog" ""
  Shape "cylinder" "float radius" [ 1.2 ] "float zmin" [ 0 ] "float zmax" [ 4 ]
AttributeEnd
