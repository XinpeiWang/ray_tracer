# curve-tuft.pbrt -- exercises Shape "curve" (a cubic Bezier hair/fiber
# strand, src/shared/shapes.h's CurveShape<T> on CPU, tessellated into
# bilinear-patch quads on GPU - src/shared/curve_tessellate.h; neither GPU
# backend has a native curve-intersection program, matching pbrt-v4's own
# GPU strategy).
#
# 24 strands via Fibonacci-sunflower disk placement, deterministic
# per-strand hash-based height/lean - the exact same formula this project's
# native (non-pbrt) curve-tuft demo scene uses
# (src/TheRestOfYourLife/scenes_advanced.h's build_curve_fibers_scene(), and
# gpu/optix/scene_builder.cpp's build_curve_fibers_scene_gpu()), so this is
# a fair CPU/GPU/native-vs-pbrt-loader comparison. Ordinary Material
# "diffuse" throughout - isolates curve GEOMETRY correctness from hair
# SHADING correctness (see hair-material.pbrt for the latter).
#
# Original, not derived from any distributed scene, so it carries no
# licence constraints.

LookAt  2.2 1.6 3.2    0.2 0.55 0    0 1 0
Camera "perspective" "float fov" [ 35 ]

Film "rgb" "integer xresolution" [ 500 ] "integer yresolution" [ 500 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.5 0.55 0.65 ]

Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.6 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -6 0 -6   6 0 -6   6 0 6   -6 0 6 ]

AttributeBegin
  Translate 0.5 3.2 0.5
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 8 8 8 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -1.5 0 -1.5   1.5 0 -1.5   1.5 0 1.5   -1.5 0 1.5 ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.250 0.140 0.060 ]
Shape "curve" "string type" [ "cylinder" ] "float width0" [ 0.045 ] "float width1" [ 0.006 ]
  "point3 P" [ 0.20207 0.00000 0.00000  0.29007 0.40892 0.00000  0.52473 0.86740 0.00000  0.78872 1.23914 0.00000 ]

