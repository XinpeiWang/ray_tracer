# mix-material.pbrt -- exercises pbrt-v4's "mix" material. Originally
# written to keep watch on this loader's largest CPU/GPU material gap: CPU
# did a real recursive stochastic blend between the two named sub-materials
# while GPU flattened the same directive to one flat Lambertian (the mix-
# weighted average of the two resolved colours). Real per-shading-point
# stochastic resolution now lands on both GPU backends too (MaterialType::
# Mix, see optix_types.h and docs/PBRT_SUPPORT.md's Materials table) - all
# three backends should render this scene's sphere with the same visible
# character: a fine-grained speckle of the matte red diffuse and the shiny
# copper-ish conductor's real specular highlights, not one smooth averaged
# colour.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 18 15 8 ]
  Translate 278 554 278
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -65 0 -52   65 0 -52   65 0 52   -65 0 52 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   555 0 0   555 0 555   0 0 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 555 555   0 555 555 ]
Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   0 0 555   0 555 555   0 555 0 ]

# ------------------------------------------------------------- the mix
# Two named sub-materials - a red diffuse and a rough copper-ish conductor -
# blended 50/50 by "amount". A real stochastic blend (CPU) and a flattened
# average-albedo Lambertian (GPU) are visibly different renders of the same
# file, which is exactly the gap this scene exists to keep watch on.
MakeNamedMaterial "mix-red" "string type" [ "diffuse" ] "rgb reflectance" [ 0.7 0.1 0.1 ]
MakeNamedMaterial "mix-copper" "string type" [ "conductor" ] "float roughness" [ 0.2 ]
Material "mix" "string materials" [ "mix-red" "mix-copper" ] "float amount" [ 0.5 ]
AttributeBegin
  Translate 278 130 278
  Shape "sphere" "float radius" [ 120 ]
AttributeEnd
