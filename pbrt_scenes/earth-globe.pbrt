# @rt-size 8
# earth-globe.pbrt -- migration of the native "A4 Earth" demo scene
# (src/TheRestOfYourLife/scenes_book.h's build_earth()) to a pbrt-backed
# scene, part of this project's GPU scene-construction-duplication
# elimination.
#
# Reuses the already-bundled images/earthmap.jpg (no new asset needed).
# Native's mipmap_texture uses Repeat wrap mode explicitly (the sphere's UV
# wraps at the antimeridian) - this loader's own "imagemap" Texture already
# defaults to "repeat" (pbrt_flatten.h's own TextureDecodeOptions::wrap
# default), so no explicit "string wrap" override is needed.
#
# Flat background: native's own CameraConfig row carries a sky-blue flat
# background (0.70, 0.80, 1.00), reproduced via LightSource "infinite".
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  0 0 12    0 0 0    0 1 0
Camera "perspective" "float fov" [ 25 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 100 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.70 0.80 1.00 ]

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 0.9 1.0 1.3 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -4.0 -2.5 -6.0   -1.0 -2.5 -6.0   -1.0 2.5 -6.0   -4.0 2.5 -6.0 ]
AttributeEnd

Texture "earth-tex" "spectrum" "imagemap" "string filename" [ "images/earthmap.jpg" ]
Material "diffuse" "texture reflectance" [ "earth-tex" ]
Shape "sphere" "float radius" [ 2 ]

Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.62 ]
AttributeBegin
  Translate 2.0 1.3 0.5
  Shape "sphere" "float radius" [ 0.35 ]
AttributeEnd
