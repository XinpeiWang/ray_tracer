# @rt-size 245
# environment-power-plant.pbrt -- migration of the native "H12 Power Plant" environment scene (scenes_mesh_gallery.h's build_*()
# + its GPU twin) to a pbrt-backed scene. Generated by scripts/gen_environment_scenes.py - rerun it
# rather than hand-editing: it ports load_obj_mtl()'s per-material rules (mesh_mtl.h) to explicit pbrt directives.
#
# The mesh is models/powerplant.obj, named once per .mtl material as Shape "plymesh" "file.obj#material"
# (ply_mesh.h's OBJ group paths), so the multi-megabyte asset stays where it is. Per material: Ke -> an
# area light; illum 7 (or illum 4/6 with a real Tf and no map_Kd) -> dielectric ("rgb tf" is the .mtl
# transmission filter); illum 2/3 with a real Ks -> conductor; map_Kd -> a diffuse imagemap; else Kd;
# map_Bump -> a displacement texture (a float imagemap for a grayscale bump, a spectrum one for a
# tangent-space normal map); map_d -> the Shape's alpha cutout. Faces whose material the .mtl does not
# define use the native scene's fallback colour.
#
# Materials: metal=56 (of 56 shapes)
# Requires models/powerplant.obj (registry requires_files=true).

LookAt  130 85 130    -55 40 -35    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 150 ]

WorldBegin

# Flat sky = the native scene's constant sky_light colour.
LightSource "infinite" "rgb L" [ 0.5 0.6 0.8 ]

# The native loader applied x*scale + offset: Translate then Scale.
AttributeBegin
  Translate -40.267 0 -26.8903
  Scale 0.0004 0.0004 0.0004

  AttributeBegin
    # sec1_material_1
    Material "conductor" "rgb reflectance" [ 0.333333 0.45098 0.45098 ] "float roughness" [ 1 ]
    Shape "plymesh" "string filename" [ "../models/powerplant.obj#sec1_material_1" ]
  AttributeEnd

  AttributeBegin
    # sec1_material_0
    Material "conductor" "rgb reflectance" [ 0 0 0.501961 ] "float roughness" [ 1 ]
    Shape "plymesh" "string filename" [ "../models/powerplant.obj#sec1_material_0" ]
  AttributeEnd

  AttributeBegin
