# @rt-category Test Scenes
# @rt-description A glowing 2 x 2 quad, lit by nothing else. --lightpath, --bdpt and the path tracer must read the same.
# @rt-performance Fast
# @rt-size 2
# lightpath-visible-quad-light.pbrt -- a 2 x 2 quad that is itself the picture, lit by nothing else: --lightpath, --bdpt and the path tracer must read the same.
#
# The only light is the emitter the camera looks at, so the frame mean is L times the area it covers - the path tracer sees it directly, --lightpath only through its
# direct light-to-camera splat.
#
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt 0 0 6  0 0 0  0 1 0
Camera "perspective" "float fov" [ 30 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 16 ]
WorldBegin

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 4 4 4 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -1 -1 0  1 -1 0  1 1 0  -1 1 0 ]
AttributeEnd
