# cone-paraboloid-lights.pbrt -- a floor lit only by a cone and a paraboloid that are area lights; --bdpt, --mlt, --sppm and the path tracer must agree.
#
# BDPT, MLT and SPPM build their light list from shapes that can sample their own surface (sample_area(), area-uniformly: the adapters take one constant position density
# per emitter) and whose material they can read. The cone and paraboloid had neither, so a scene lit only by them rendered with no light at all under --bdpt/--mlt/--sppm.
# Same layout as disk-cylinder-light.pbrt.
#
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt  0 3 8    0 0 0    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 480 ] "integer yresolution" [ 320 ]
Sampler "halton" "integer pixelsamples" [ 16 ]

WorldBegin

Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.65 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -6 0 -6   6 0 -6   6 0 6   -6 0 6 ]

AttributeBegin
  Translate -2 0.01 0
  Rotate -90 1 0 0
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 10 10 10 ]
  Shape "cone" "float radius" [ 0.8 ] "float height" [ 2.5 ]
AttributeEnd

AttributeBegin
  Translate 2 0.01 0
  Rotate -90 1 0 0
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 8 8 8 ]
  Shape "paraboloid" "float radius" [ 0.8 ] "float zmin" [ 0 ] "float zmax" [ 2 ]
AttributeEnd
