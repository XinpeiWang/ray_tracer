# @rt-category Test Scenes
# @rt-description The same closed box with a rough metal sphere. BDPT and the path tracer must agree on glossy metal reflections.
# @rt-performance Fast
# bdpt-box-room-roughmetal.pbrt -- the closed box of bdpt-box-room.pbrt (light facing up) with a rough conductor sphere in it; BDPT and the path tracer agree.
#
# BDPT/MLT took the conductor's colour from scatter() - one Fresnel value per hit, at the view-normal cosine - where the path tracer asks
# scattering_attenuation() for the direction pair actually evaluated (Fresnel at the half vector): ~1-4% too bright, more at larger roughness.

LookAt  5 5 1    5 5 10    0 1 0
Camera "perspective" "float fov" [ 70 ]

Film "rgb" "integer xresolution" [ 48 ] "integer yresolution" [ 48 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

# The light: a 3 x 3 plate near the ceiling facing UP (counter-clockwise seen from above), so it lights the ceiling and is not visible to the camera:
# the lit surfaces, not an emitter, make up the image.
AttributeBegin
  # An emitter only: without a Material pbrt gives the plate its default 0.5 diffuse, and its underside (visible at the top of the frame) would reflect.
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 12 12 12 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 3.5 8 5   3.5 8 8   6.5 8 8   6.5 8 5 ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
# floor, ceiling, back, front, left, right
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 0   0 0 10   10 0 10   10 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 10 0   10 10 0   10 10 10   0 10 10 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 10   0 10 10   10 10 10   10 0 10 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 0   10 0 0   10 10 0   0 10 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 0   0 10 0   0 10 10   0 0 10 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 10 0 0   10 0 10   10 10 10   10 10 0 ]

Material "conductor" "rgb reflectance" [ 0.8 0.8 0.9 ] "float roughness" [ 0.5 ]
AttributeBegin
  Translate 5 3.5 5
  Shape "sphere" "float radius" [ 2.5 ]
AttributeEnd
