# cloud-medium-scene.pbrt -- migration of the native "E2 Cloud Medium" demo
# scene (src/TheRestOfYourLife/scenes_advanced.h's build_cloud_medium_scene())
# to a pbrt-backed scene, part of this project's GPU scene-construction-
# duplication elimination.
#
# Not to be confused with the already-bundled pbrt_scenes/cloud-medium.pbrt
# example (a different, standalone demo of the same MakeNamedMedium "cloud"
# feature) - this file instead reproduces E2's own specific parameters
# exactly: sigma_s=10 (not that example's 0.6), frequency=4 (not 5), and
# E2's own ground+context-sphere layout.
#
# Medium-space mapping: native maps world box (-4,1,-3)-(4,4,3) onto the
# medium's default [0,1]^3 via Translate(min) then Scale(size) - same
# convention as cloud-medium.pbrt's own header comment (Translate BEFORE
# Scale, both before MakeNamedMedium, so the CTM at declaration time IS
# that composed transform).
#
# Trigger sphere: GPU's medium dispatch is sphere-hit-triggered only (same
# limitation as cloud-medium.pbrt) - centered on the box (0,2.5,0), radius
# 5.5 (> the box's own half-diagonal, sqrt(4^2+1.5^2+3^2)=5.22, so the
# sphere fully encloses it). The actual visible cloud shape comes from the
# density function's own [0,1]^3 domain, not the trigger sphere's shape, so
# this reproduces native's box-shaped cloud exactly despite the sphere
# trigger.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  0 4 26    0 2 0    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 300 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.5 0.7 1.0 ]

Material "diffuse" "rgb reflectance" [ 0.4 0.5 0.3 ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

AttributeBegin
  Translate -4 1 -3
  Scale 8 3 6
  MakeNamedMedium "puffcloud" "string type" [ "cloud" ]
    "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 10.0 10.0 10.0 ] "float g" [ 0.3 ]
    "float density" [ 1 ] "float wispiness" [ 1 ] "float frequency" [ 4 ]
AttributeEnd

AttributeBegin
  Translate 0 2.5 0
  Material "interface"
  MediumInterface "puffcloud" ""
  Shape "sphere" "float radius" [ 5.5 ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.9 0.3 0.2 ]
AttributeBegin
  Translate -6 0.5 4
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd

Material "conductor" "rgb reflectance" [ 0.8 0.8 0.9 ] "float roughness" [ 0.05 ]
AttributeBegin
  Translate 6 0.5 4
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd
