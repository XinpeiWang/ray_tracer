# flush-ceiling-light.pbrt -- regression scene for a GPU shadow-ray bug: a closed 5-unit room lit only by a
# 1x1 ceiling light that sits 0.005 units below the ceiling, the way a lamp fixture does.
#
# The GPU used to nudge a shadow ray's origin by 0.01 and leave its length measured from the un-nudged shading
# point, so every ray aimed at a finite light overshot it by the nudge and, here, ended inside the ceiling 0.005
# behind the light: the sample was reported blocked. Recursive rendered this room at 22% of the CPU's
# brightness and wavefront at 37%. With the light 0.05 or more below the ceiling all three agreed, which is why
# no earlier scene noticed. See tests/unit/pbrt_example_scenes_tests.cpp (FlushCeilingLightAgreesAcrossBackends).
#
# The light quad is wound so it faces down (-y); everything else is plain 0.6 diffuse.

LookAt 0 2.25 2.375  0 2 0  0 1 0
Camera "perspective" "float fov" [ 70 ]
Film "rgb" "integer xresolution" [ 200 ] "integer yresolution" [ 200 ]
Sampler "halton" "integer pixelsamples" [ 100 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0 0 0 ]

Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.6 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -2.5 0 -2.5   2.5 0 -2.5   2.5 0 2.5   -2.5 0 2.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -2.5 5 2.5   2.5 5 2.5   2.5 5 -2.5   -2.5 5 -2.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -2.5 0 -2.5   -2.5 5 -2.5   2.5 5 -2.5   2.5 0 -2.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -2.5 0 2.5   2.5 0 2.5   2.5 5 2.5   -2.5 5 2.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -2.5 0 -2.5   -2.5 0 2.5   -2.5 5 2.5   -2.5 5 -2.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 2.5 0 -2.5   2.5 5 -2.5   2.5 5 2.5   2.5 0 2.5 ]

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 4 4 4 ]
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0.5 4.995 -0.5   0.5 4.995 0.5   -0.5 4.995 0.5   -0.5 4.995 -0.5 ]
AttributeEnd
