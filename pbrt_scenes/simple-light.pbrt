# @rt-size 9
# simple-light.pbrt -- migration of the native "A7 Simple Light" book scene
# (scenes_book.h's build_simple_light(), its GPU case, and Metal's hand-authored
# copy) to a pbrt-backed scene.
#
# Same marble substitution as perlin-spheres.pbrt (native noise_texture(4) ->
# pbrt-v4's "marble" Texture, scale 4) - see that file's header for why.
#
# Two lights, as native: a warm sphere light (0,7,0) r=2, emission (6,3,1), and a
# cool 2x2 quad Q=(3.5,1,-3) u=(2,0,0) v=(0,2,0), emission (2,3,6), whose
# u x v = +z so it faces the +z side. No sky (native background is black).
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  26 3 6    0 2 0    0 1 0
Camera "perspective" "float fov" [ 20 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 100 ]

WorldBegin

Texture "marble-4" "spectrum" "marble" "float scale" [ 4 ]
Material "diffuse" "texture reflectance" [ "marble-4" ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd
AttributeBegin
  Translate 0 2 0
  Shape "sphere" "float radius" [ 2 ]
AttributeEnd

# Warm sphere light above
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 6 3 1 ]
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  Translate 0 7 0
  Shape "sphere" "float radius" [ 2 ]
AttributeEnd

# Cool quad light to the side
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 2 3 6 ]
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 3.5 1 -3   5.5 1 -3   5.5 3 -3   3.5 3 -3 ]
AttributeEnd
