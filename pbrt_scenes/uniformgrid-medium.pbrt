    0.3314 0.4255 0.4255 0.3314 0.2010 0.0949 0.0739 0.1565 0.2581
    0.3314 0.3314 0.2581 0.1565 0.0739 0.0448 0.0949 0.1565 0.2010
    0.2010 0.1565 0.0949 0.0448 0.0212 0.0448 0.0739 0.0949 0.0949
    0.0739 0.0448 0.0212 0.0272 0.0576 0.0949 0.1219 0.1219 0.0949
    0.0576 0.0272 0.0576 0.1219 0.2010 0.2581 0.2581 0.2010 0.1219
    0.0576 0.0949 0.2010 0.3314 0.4255 0.4255 0.3314 0.2010 0.0949
    0.1219 0.2581 0.4255 0.5463 0.5463 0.4255 0.2581 0.1219 0.1219
    0.2581 0.4255 0.5463 0.5463 0.4255 0.2581 0.1219 0.0949 0.2010
