    ]
AttributeEnd

# Trigger sphere: centered on the world-space box above (min (198,200,170),
# max (358,360,330), center (278,280,250)), radius past its half-diagonal
# (80*sqrt(3) =~ 138.6) so the whole box is enclosed.
AttributeBegin
  Translate 278 280 250
  Material "dielectric" "float eta" [ 1.001 ]
  MediumInterface "puff" ""
  Shape "sphere" "float radius" [ 145 ]
AttributeEnd
