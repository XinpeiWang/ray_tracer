# depth-of-field.pbrt -- exercises a perspective camera's "lensradius"/
# "focaldistance" (pbrt-v4's thin-lens depth-of-field model). No bundled
# example scene set either parameter before this one - every camera in this
# folder was a pinhole. This is exactly the pair a real unit-conversion bug
# hid in once already: CPU's lensradius->defocus_angle conversion was wrong
# by a unit (world-space radius vs. an angle) until it was caught, and GPU
# didn't read a LOADED pbrt scene's lensradius/focaldistance at all until a
# separate fix wired it up - neither gap would have been visible without a
# render that actually asked for DOF.
#
# Three spheres at increasing depth along the view axis: with the focal
# plane set near the middle one, the near and far spheres should read
# visibly softer than it - not something this file's own render-smoke test
# checks pixel-by-pixel, but worth looking at by eye after a change here.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ] "float lensradius" [ 20 ] "float focaldistance" [ 800 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 18 15 8 ]
  Translate 278 554 278
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -65 0 -52   65 0 -52   65 0 52   -65 0 52 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   555 0 0   555 0 555   0 0 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 555 555   0 555 555 ]
Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   0 0 555   0 555 555   0 555 0 ]

# near sphere (in front of the focal plane)
Material "diffuse" "rgb reflectance" [ 0.8 0.8 0.2 ]
AttributeBegin
  Translate 180 90 60
  Shape "sphere" "float radius" [ 70 ]
AttributeEnd

# mid sphere (at the focal plane - should read sharp)
Material "diffuse" "rgb reflectance" [ 0.2 0.8 0.8 ]
AttributeBegin
  Translate 278 90 278
  Shape "sphere" "float radius" [ 70 ]
AttributeEnd

# far sphere (behind the focal plane)
Material "diffuse" "rgb reflectance" [ 0.8 0.2 0.8 ]
AttributeBegin
  Translate 380 90 490
  Shape "sphere" "float radius" [ 70 ]
AttributeEnd
