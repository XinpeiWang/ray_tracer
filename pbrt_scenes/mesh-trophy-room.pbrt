# @rt-size 10.1
# mesh-trophy-room.pbrt -- migration of the native "G12" mesh-gallery scene (scenes_mesh_gallery.h's
# build_trophy_room() + its GPU twin in scene_builder_mesh_gallery.h) to a pbrt-backed scene. Every number
# below was transcribed by a one-off generator from those builders and the registry row, not
# retyped.
#
# The mesh is a Wavefront OBJ named by Shape "plymesh" (this project's loader reads .obj by
# extension - src/shared/ply_mesh.h's OBJ SUPPORT note), relative to this file, so the multi-
# megabyte asset in models/ is used as-is. It carries no vn records, so it shades with flat
# per-face normals exactly like the native scene. Native metal(albedo, fuzz) is expressed as
# Material "conductor" with the same reflectance and roughness = fuzz, as every earlier
# migration did. The file is skipped by the suite when the asset is absent (registry
# requires_files=true).

LookAt  0 2.3 14    0 0.9 0    0 1 0
Camera "perspective" "float fov" [ 34 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

# Flat sky = the native scene's constant background colour.
LightSource "infinite" "rgb L" [ 0.05 0.05 0.08 ]

AttributeBegin
  Scale 0.8 0.8 0.8
  Texture "ground-checker" "spectrum" "checkerboard" "integer dimension" [ 3 ]
    "rgb tex1" [ 0.15 0.15 0.15 ] "rgb tex2" [ 0.85 0.85 0.85 ]
AttributeEnd
Material "diffuse" "texture reflectance" [ "ground-checker" ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 6 6 6 ]
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  Translate 0 8 0
  Shape "sphere" "float radius" [ 2 ]
AttributeEnd

AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.71 0.43 0.2 ] "float roughness" [ 0.15 ]
  Translate -3.32576 -0.34123 0.01589
  Scale 10.3467 10.3467 10.3467
  Shape "plymesh" "string filename" [ "../models/stanford-bunny.obj" ]
AttributeEnd

AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.85 0.85 0.88 ] "float roughness" [ 0.1 ]
  Translate -2.07211 0 0
  Scale 0.50794 0.50794 0.50794
  Shape "plymesh" "string filename" [ "../models/teapot.obj" ]
AttributeEnd

AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.83 0.69 0.22 ] "float roughness" [ 0.05 ]
  Translate 3.22694 -0.35723 -3.33526
  Scale 0.8127 0.8127 0.8127
  Shape "plymesh" "string filename" [ "../models/suzanne.obj" ]
AttributeEnd

AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.55 0.56 0.58 ] "float roughness" [ 0.08 ]
  Translate 3.5 0.69739 -0.17989
  Rotate 180 0 1 0
  Scale 0.94651 0.94651 0.94651
  Shape "plymesh" "string filename" [ "../models/spot.obj" ]
AttributeEnd
