# subsurface-ball.pbrt -- pbrt's SubsurfaceMaterial (a tabulated BSSRDF) in a Cornell box.
#
# Two balls: a "Marble" preset one and one with explicit coefficients (a pale, strongly scattering wax), both with "scale" chosen so that the
# mean free path is a fair fraction of the ball's size, i.e. clearly translucent: light that enters a ball leaves it elsewhere, softening
# shadows and bleeding the red and green walls' colour through. The material is the smooth dielectric boundary plus the diffusion-profile
# BSSRDF (pbrt-v4's SubsurfaceMaterial); the CPU, OptiX and Metal all implement it, with a probe walk to find the exit point.
#
# Original, so it carries no licence constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 300 ] "integer yresolution" [ 300 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 12 12 12 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 213 554 227   343 554 227   343 554 332   213 554 332 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 555 555   555 555 555 ]

# ---------------------------------------------------------------- wax "slab" (sphere approximation - see header)

Material "subsurface" "string name" [ "Marble" ] "float scale" [ 0.012 ] "float eta" [ 1.5 ]
AttributeBegin
  Translate 370 150 310
  Shape "sphere" "float radius" [ 150 ]
AttributeEnd

Material "subsurface" "rgb sigma_a" [ 0.0011 0.0024 0.014 ] "rgb sigma_s" [ 2.55 3.21 3.77 ] "float scale" [ 0.012 ] "float eta" [ 1.33 ]
AttributeBegin
  Translate 160 90 160
  Shape "sphere" "float radius" [ 90 ]
AttributeEnd
