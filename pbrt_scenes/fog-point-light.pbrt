# @rt-category Test Scenes
# @rt-description A fog ball lit by a point light, with a closed-form answer. Checks scattering and absorption inside a medium.
# @rt-performance Fast
# @rt-size 20
# fog-point-light.pbrt -- regression scene for two participating-medium bugs, with a closed-form check.
#
# A fog sphere (radius 10, sigma_s 0.05, optical depth ~1 across the diameter, isotropic) lit only by a
# point light, in a black world, seen from outside. Mean linear pixel radiance from an independent Monte
# Carlo solution of the same setup (full multiple scattering, next-event estimation to the point light with
# exact transmittance, 64x64 pixels at this camera): 0.3562. After the fixes all three backends land within
# 0.4% of it.
#
#   * CPU: a shadow ray walking through a medium multiplied by the medium's transmittance T only on the
#     rays whose random free-path sample landed inside it, and not at all on the rest, so the expected
#     visibility was T * (2 - T) instead of T. Invisible in thin fog, but here the CPU rendered 0.44, 24%
#     too bright (and 76% too bright at sigma_s 0.15).
#   * GPU recursive: a scatter event in a medium never sampled punctual lights, so this scene rendered
#     black there.
#
# See tests/unit/pbrt_example_scenes_tests.cpp (FogPointLightAgreesAcrossBackends).

LookAt 0 0 -40  0 0 0  0 1 0
Camera "perspective" "float fov" [ 30 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

LightSource "point" "rgb I" [ 5000 5000 5000 ] "point3 from" [ 0 20 0 ]

MakeNamedMedium "fog" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 0.05 0.05 0.05 ] "float g" [ 0 ]

AttributeBegin
  Material "interface"
  MediumInterface "fog" ""
  Shape "sphere" "float radius" [ 10 ]
AttributeEnd
