# @rt-category Test Scenes
# @rt-description A NanoVDB fog sphere that scatters without absorbing, under a white sky. It must be invisible: every pixel reads exactly 1.
# @rt-performance Fast
# nanovdb-furnace.pbrt -- a white furnace for the NanoVDB medium.
#
# pbrt_scenes/nanovdb-sphere.nvdb is a soft fog-volume sphere (native radius 1.5, density falling off toward the edge). With sigma_a = 0 it scatters
# without absorbing, so under a uniform sky, by energy conservation, every pixel comes out as the sky itself whatever the density field: the grid
# must be invisible. A wrong majorant (too low, so null collisions get negative weight), a scattering scale applied twice, or a grid placed or
# scaled differently from the CPU's all leave a visible patch or a pixel mean away from 1. The CPU and the OptiX renderers can agree with each
# other and still all be wrong; this is the check that does not depend on them agreeing. The depth limit is set high in the tests (40): a path
# through the thick middle scatters many times.
#
# Original, so it carries no licence constraints beyond NanoVDB's own for the bundled .nvdb file (src/external/nanovdb/LICENSE).

LookAt  0 0 8    0 0 0    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

LightSource "infinite" "rgb L" [ 1 1 1 ]

# The grid's own native extent is roughly a 3.5-unit cube centred on the origin, so it is used at scale 1.
AttributeBegin
  MakeNamedMedium "fog" "string type" [ "nanovdb" ]
    "string filename" [ "nanovdb-sphere.nvdb" ]
    "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 1.5 1.5 1.5 ] "float g" [ 0.3 ]
AttributeEnd

# The trigger sphere: its radius is past the grid's half-diagonal (about 3.0), so the whole grid is inside.
AttributeBegin
  Material "interface"
  MediumInterface "fog" ""
  Shape "sphere" "float radius" [ 3.2 ]
AttributeEnd
