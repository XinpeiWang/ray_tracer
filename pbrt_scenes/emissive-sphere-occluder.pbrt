# emissive-sphere-occluder.pbrt -- a dim emissive sphere hanging between a big quad lamp and a diffuse floor. Like every
# pbrt-v4 surface an emitter blocks light: the floor under the ball is in its shadow.
#
# What this guards: both GPU backends' sphere shadow any-hit programs ignored every emissive sphere ("a shadow ray sampled
# toward a light is expected to end on that light's own surface"), so a sphere that was NOT the light being sampled - another
# lamp, a glowing bulb, an emissive ball - cast no shadow on the GPU. This scene read 116.9% of the CPU on both backends (a dark
# ball, an emissive disk and an emissive cylinder in the same place were all fine). The shadow ray already stops 0.002 short of
# its target and sphere lights are cone-sampled (the target is on the near side), so the sphere's own light is never in the way;
# a sphere light lighting a floor and a ball still agrees with the CPU to 0.1%.
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt  0 6 9    0 0 0    0 1 0
Camera "perspective" "float fov" [ 45 ]

Film "rgb" "integer xresolution" [ 200 ] "integer yresolution" [ 200 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -8 0 -8  8 0 -8  8 0 8  -8 0 8 ]
AttributeEnd

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 8 8 8 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -3 7 -3  3 7 -3  3 7 3  -3 7 3 ]
AttributeEnd

AttributeBegin
  Translate 0 3 0
  AreaLightSource "diffuse" "rgb L" [ 0.5 0.5 0.5 ]
  Shape "sphere" "float radius" [ 1.2 ]
AttributeEnd
