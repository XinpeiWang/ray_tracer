# cornell-coated-conductor.pbrt -- migration of the native "B7 Cornell
# Coated Conductor" demo scene (src/TheRestOfYourLife/scenes_materials.h's
# build_cornell_coated_conductor(), gpu/optix/scene_builder.cpp's own
# build_cornell_coated_conductor()) to a pbrt-backed scene, part of this
# project's GPU scene-construction-duplication elimination.
#
# Walls/light/box are IDENTICAL to cornell-conductor.pbrt (both read from
# cornell_box_data.h) - see that file's own header comment. Background
# (0.05,0.055,0.07), same as cornell-conductor.pbrt.
#
# Gold/copper eta/k transcribed exactly from src/shared/conductor_data.h's
# kConductorAu/kConductorCu, same reasoning as cornell-conductor.pbrt's own
# header comment (explicit "rgb eta"/"rgb k" rather than a named spectrum,
# to guarantee the exact same numbers both backends already use natively).
# Coat "float eta" [1.5] is the dielectric lacquer coat's own IOR (parsed
# generically for coateddiffuse/coatedconductor - confirmed against
# pbrt_flatten.h's own `m.ior = params.getFloat("eta", params.getFloat("ior",
# 1.5))` - not the conductor base's eta, which is "rgb eta" instead).
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.05 0.055 0.07 ]

# ---------------------------------------------------------------- light
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 15 15 15 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 213 554 227   343 554 227   343 554 332   213 554 332 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 555 555   555 555 555 ]

# ---------------------------------------------------------------- contents
# Lacquered-copper box (kConductorCu, coat ior 1.5, coat roughness 0.2)
Material "coatedconductor" "rgb eta" [ 0.246 1.072 1.155 ] "rgb k" [ 3.378 2.591 2.469 ] "float eta" [ 1.5 ] "float roughness" [ 0.2 ]
AttributeBegin
  Translate 265 0 295
  Rotate 15 0 1 0
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 165   165 0 165   165 330 165   0 330 165 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 165   165 0 0   165 330 0   165 330 165 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 0   0 0 0   0 330 0   165 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   0 0 165   0 330 165   0 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 330 165   165 330 165   165 330 0   0 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   165 0 0   165 0 165   0 0 165 ]
AttributeEnd

# Lacquered-gold sphere (kConductorAu, coat ior 1.5, coat roughness 0.1)
Material "coatedconductor" "rgb eta" [ 0.184 0.457 1.354 ] "rgb k" [ 3.070 2.408 1.818 ] "float eta" [ 1.5 ] "float roughness" [ 0.1 ]
AttributeBegin
  Translate 190 90 190
  Shape "sphere" "float radius" [ 90 ]
AttributeEnd
