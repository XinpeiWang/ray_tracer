# @rt-category Test Scenes
# @rt-description A lit closed room with a ball of fog whose absorption and scattering both differ by colour. BDPT, MLT and SPPM render it as three one-colour passes.
# @rt-performance Fast
# @rt-size 10
# chromatic-fog-room.pbrt -- a lit closed room with a ball of fog whose absorption and scattering both differ by colour.
#
# BDPT, MLT and SPPM can only sample ONE extinction for a medium (constant_medium::hit()), so a fog thicker in one channel than another rendered
# grey there. They now render such a scene as three passes - pass c with the grey medium of channel c - and keep channel c of pass c; each channel
# of the result must then agree with the default path tracer, which samples the per-channel extinction itself. No closed form: the path tracer is the
# reference, channel by channel (red is the thin channel, blue the thick one, so a grey average would read red too dark and blue too bright).
#
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt  5 5 1    5 5 10    0 1 0
Camera "perspective" "float fov" [ 70 ]

Film "rgb" "integer xresolution" [ 48 ] "integer yresolution" [ 48 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 12 12 12 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 3.5 8 5   6.5 8 5   6.5 8 8   3.5 8 8 ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 0   0 0 10   10 0 10   10 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 10 0   10 10 0   10 10 10   0 10 10 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 10   0 10 10   10 10 10   10 0 10 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 0   10 0 0   10 10 0   0 10 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 0 0   0 10 0   0 10 10   0 0 10 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 10 0 0   10 0 10   10 10 10   10 10 0 ]

MakeNamedMedium "fog" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0.02 0.10 0.35 ] "rgb sigma_s" [ 0.10 0.25 0.45 ] "float g" [ 0.3 ]

AttributeBegin
  Material "interface"
  MediumInterface "fog" ""
  Translate 5 4.5 5
  Shape "sphere" "float radius" [ 2.5 ]
AttributeEnd
