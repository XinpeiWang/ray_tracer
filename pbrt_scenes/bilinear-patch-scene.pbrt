# bilinear-patch-scene.pbrt -- migration of the native "F1 Bilinear Patch"
# demo scene (src/TheRestOfYourLife/scenes_advanced.h's
# build_bilinear_patch_scene()) to a pbrt-backed scene, part of this
# project's GPU scene-construction-duplication elimination.
#
# Cornell box geometry (walls + light) is IDENTICAL to cornell-box-native.pbrt
# (A1) - see that file's own header comment.
#
# Uses real pbrt-v4 Shape "bilinearmesh" (single-patch form, "point3 P" with
# 4 corners in (u,v)=(0,0),(1,0),(0,1),(1,1) order) - already fully
# supported by this loader on both backends (pbrt_flatten.h's own
# BilinearPatch comment), matching native's own bilinear_patch_hittable
# corner ordering (p00,p10,p01,p11) exactly.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 15 15 15 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 213 554 227   343 554 227   343 554 332   213 554 332 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 555 555   555 555 555 ]

# ---------------------------------------------------------------- patches
# Saddle patch: p00/p11 high, p10/p01 low (hyperbolic paraboloid)
Material "conductor" "rgb reflectance" [ 0.8 0.7 0.3 ] "float roughness" [ 0.15 ]
Shape "bilinearmesh" "point3 P" [
  150  80 200    400  50 200
  150  50 400    400  80 400
]

# Curved ramp patch
Material "conductor" "rgb reflectance" [ 0.2 0.4 0.8 ] "float roughness" [ 0.25 ]
Shape "bilinearmesh" "point3 P" [
  200 200 220    370 200 220
  150 380 420    420 320 420
]
