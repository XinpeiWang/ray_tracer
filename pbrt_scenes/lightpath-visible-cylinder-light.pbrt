# @rt-category Test Scenes
# @rt-description A glowing cylinder with its axis across the view, lit by nothing else. --lightpath, --bdpt and the path tracer must read the same.
# @rt-performance Fast
# lightpath-visible-cylinder-light.pbrt -- a cylinder (axis across the view) that is itself the picture, lit by nothing else: --lightpath, --bdpt and the path tracer must read the same.
#
# The only light is the emitter the camera looks at, so the frame mean is L times the area it covers - the path tracer sees it directly, --lightpath only through its
# direct light-to-camera splat. Same defect as the sphere: 0.52x.
#
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt 0 0 6  0 0 0  0 1 0
Camera "perspective" "float fov" [ 30 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 16 ]
WorldBegin

AttributeBegin
  Rotate 90 1 0 0
  Translate 0 0 -1
  AreaLightSource "diffuse" "rgb L" [ 4 4 4 ]
  Shape "cylinder" "float radius" [ 1 ] "float zmin" [ 0 ] "float zmax" [ 2 ]
AttributeEnd
