  Translate -4 1 -4
  Scale 8 4 8
  MakeNamedMedium "nebula" "string type" [ "rgbgrid" ]
    "integer nx" [ 24 ] "integer ny" [ 24 ] "integer nz" [ 24 ]
    "float g" [ 0.2 ]
