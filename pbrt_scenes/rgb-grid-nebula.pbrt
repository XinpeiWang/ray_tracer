# @rt-size 13
# rgb-grid-nebula.pbrt -- migration of the native "E4 RGB Grid Medium"
# demo scene (src/TheRestOfYourLife/scenes_advanced.h's
# build_rgb_grid_medium_scene()) to a pbrt-backed scene, part of this
# project's GPU scene-construction-duplication elimination.
#
# The "rgb sigma_s" array below is NOT hand-authored - it is the exact
# baked output of this project's own generate_nebula_channel<double>()
# (src/shared/rgb_nebula_generator.h), the SAME function
# build_rgb_grid_medium_scene() and its GPU twin both call, with the same
# parameters (nx=ny=nz=24, freq=3.0, per-channel offsets
# (0,0,0)/(5.2,1.7,3.3)/(11.4,8.8,2.1)) and the same sigma_scale=4.0
# multiplier baked in. This loader always passes sigma_scale=1.0 for a
# loaded "rgbgrid" medium (see gpu/optix/pbrt_gpu_builder.h and
# src/TheRestOfYourLife/pbrt_cpu_builder.h, both hardcoding 1.0 - there is
# no pbrt directive to set it at load time), so native's own 4.0 multiplier
# had to be baked into the literal array values instead of passed as a
# parameter. Generated once by a throwaway C++ program
# (scratch_gen_e4_nebula.cpp, not checked in) that #included the same
# generate_nebula_channel() header and dumped its output - not guessed,
# not hand-typed.
#
# "rgb sigma_a" is an explicit all-zero array, not omitted: an omitted
# sigma_a grid defaults to 1.0 per voxel (RGBGridMediumData::build()'s own
# documented default), not 0 - matching native's own explicit sa_zero
# vector (scenes_advanced.h's own comment: "must be non-empty to actually
# get 0").
#
# Medium-space mapping: native's world box is (-4,1,-4)-(4,5,4) - mapped
# onto the medium's default [0,1]^3 via Translate(min) then Scale(size),
# same convention as cloud-medium-scene.pbrt's own header comment.
#
# Trigger sphere: GPU's medium dispatch is sphere-hit-triggered only (same
# limitation as E1/E2/E3's own migrations) - centered on the box (0,3,0),
# radius 6.2 (> the box's own half-diagonal, sqrt(4^2+2^2+4^2)=6.0, so the
# sphere fully encloses it). The actual visible nebula shape comes from the
# density grid's own [0,1]^3 domain, not the trigger sphere's shape, so
# this reproduces native's box-shaped nebula exactly despite the sphere
# trigger.
#
# Ground and context spheres are byte-for-byte the same as E2's own
# cloud-medium-scene.pbrt (native's build_rgb_grid_medium_scene() reuses
# E2's exact ground color and context-sphere layout, per its own "Context
# spheres, same idea as E2's" comment).
#
# Original (modulo the generated array, itself original output of this
# project's own code, not a distributed dataset), so it carries no licence
# constraints.

LookAt  0 5 30    0 3 0    0 1 0
Camera "perspective" "float fov" [ 45 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 300 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.5 0.7 1.0 ]

Material "diffuse" "rgb reflectance" [ 0.4 0.5 0.3 ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

