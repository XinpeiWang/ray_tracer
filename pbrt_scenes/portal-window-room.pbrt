# @rt-size 555
# portal-window-room.pbrt -- migration of the native "C7 Portal Infinite
# Light" demo scene (src/TheRestOfYourLife/scenes_advanced.h's
# build_portal_light_scene()/build_portal_sky()) to a pbrt-backed scene,
# part of this project's GPU scene-construction-duplication elimination.
#
# Native's own registry description is candid that this is a simple flat-
# color sky_light behind a geometric hole in the back wall, NOT the real
# pbrt-v4 PortalImageInfiniteLight class (see the already-bundled
# pbrt_scenes/portal-light.pbrt for that real feature) - this migration
# reproduces the SAME simple approximation exactly, not the more advanced
# one.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 300 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.55 0.65 0.85 ]

# ---------------------------------------------------------------- walls (no ceiling light - sky through portal)
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]

# Back wall with a 245x245 window cut into it (4 border strips), sky visible through it.
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 400 555   0 400 555   0 555 555   555 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 155 555   555 155 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 155 555   400 155 555   400 400 555   555 400 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 155 155 555   0 155 555   0 400 555   155 400 555 ]

Material "conductor" "rgb reflectance" [ 0.8 0.8 0.9 ] "float roughness" [ 0.05 ]
AttributeBegin
  Translate 190 100 190
  Shape "sphere" "float radius" [ 100 ]
AttributeEnd
