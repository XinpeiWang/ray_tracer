  ActiveTransform "StartTime"
  Translate -10.283112 0.2 -10.144357
  ActiveTransform "EndTime"
  Translate -10.283112 0.42291635 -10.144357
  ActiveTransform "All"
  Shape "sphere" "float radius" [ 0.2 ]
AttributeEnd

