# @rt-size 22.2
# bouncing-spheres.pbrt -- migration of the native "A2 Bouncing Spheres"
# demo scene (src/TheRestOfYourLife/scenes_book.h's build_bouncing_spheres(),
# the "In One Weekend" book's own final-render scene) to a pbrt-backed
# scene, part of this project's GPU scene-construction-duplication
# elimination.
#
# The 481 small grid spheres below are NOT hand-authored or newly
# randomized - they are the literal, deterministic output of GPU's own
# build_bouncing_spheres() (gpu/optix/scene_builder.cpp): a fixed
# std::mt19937(42) seed with std::uniform_real_distribution<float>(0,1),
# sampled in the exact same order GPU's own loop uses, dumped by a
# throwaway C++ program (scratch_gen_a2_bouncing.cpp, not checked in) that
# replicated that exact call sequence. CPU's OWN build_bouncing_spheres()
# uses unseeded random_double() (std::random_device-backed) and produces a
# genuinely different random layout on every single run - it has no fixed
# reference layout to match at all (see that function's own GPU-side
# header comment: "none of which reproduce the CPU's exact random sequence
# either") - so GPU's already-deterministic layout is the only reproducible
# choice available, and reusing it exactly (rather than inventing a third
# layout) keeps this migration from adding yet another independent random
# sequence to a scene that already has two.
#
# Motion blur: each diffuse grid sphere "bounces" - real per-shape motion
# blur via ActiveTransform "StartTime"/"EndTime" bracketing two different
# Translate CTMs (pbrt_flatten.h bakes this into Sphere::center1, sampled
# per-ray by the default [0,1] shutter interval), matching both CPU's
# `sphere(center1, center2, radius, mat)` moving-sphere constructor and
# GPU's own `SphereData::center1` field exactly - not an approximation,
# see object-motion-blur.pbrt's own header comment for this same mechanism
# proven on all 3 backends already.
#
# Depth of field: native's CameraConfig row carries defocus_angle=0.6
# degrees and focus_dist=10.0 world units ("the book's own final-render
# values ... a subtle depth-of-field beauty shot") - converted to pbrt's
# "lensradius" the same way every other migrated DOF scene in this project
# does (see cornell-dof.pbrt's own derivation): lensradius =
# 10*tan(0.3 degrees) = 0.052360356057001275.
#
# Original, not derived from any distributed scene, so it carries no
# licence constraints.

LookAt  13 2 3    0 0 0    0 1 0
Camera "perspective" "float fov" [ 20 ]
  "float lensradius" [ 0.052360356057001275 ] "float focaldistance" [ 10.0 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 100 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.70 0.80 1.00 ]

# ---------------------------------------------------------- checker ground
AttributeBegin
  Scale 0.32 0.32 0.32
  Texture "ground-checker" "spectrum" "checkerboard" "integer dimension" [ 3 ]
    "rgb tex1" [ 0.2 0.3 0.1 ] "rgb tex2" [ 0.9 0.9 0.9 ]
AttributeEnd
Material "diffuse" "texture reflectance" [ "ground-checker" ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

# ---------------------------------------------------------- hero spheres
Material "dielectric" "float eta" [ 1.5 ]
AttributeBegin
  Translate 0 1 0
  Shape "sphere" "float radius" [ 1.0 ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.4 0.2 0.1 ]
AttributeBegin
  Translate -4 1 0
  Shape "sphere" "float radius" [ 1.0 ]
AttributeEnd

Material "conductor" "rgb reflectance" [ 0.7 0.6 0.5 ] "float roughness" [ 0.0 ]
AttributeBegin
  Translate 4 1 0
  Shape "sphere" "float radius" [ 1.0 ]
AttributeEnd

# ---------------------------------------------------------- grid spheres (481)
Material "diffuse" "rgb reflectance" [ 0.13427314 0.46676859 0.093119733 ]
