# @rt-size 12
# rough-metal-spheres.pbrt -- migration of the native "B1 Rough Metal Spheres" scene
# (scenes_materials.h's build_rough_metal_spheres(), its GPU case, and Metal's
# hand-authored copy) to a pbrt-backed scene.
#
# Five GGX spheres, roughness 0.05 .. 0.8, in a gold-ish tint (0.95,0.85,0.55).
# Native's rough_metal has a flat tint with no Fresnel and alpha =
# RoughnessToAlpha(roughness); the pbrt expression of a tinted rough metal is
# Material "conductor" with "rgb reflectance" (pbrt-v4 derives eta/k from it so the
# normal-incidence reflectance equals the tint, with real angle-dependent Fresnel)
# and the same roughness (remaproughness defaults to true = the same sqrt mapping).
# That is a small, deliberate fidelity change near grazing angles, not a
# transcription error.
#
# The sky is native's flat (0.10,0.10,0.12) background as a constant infinite
# light - its absence on the GPU was the long-standing B1 "gap".
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  0 2.7 17    0 1 0    0 1 0
Camera "perspective" "float fov" [ 42 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.1 0.1 0.12 ]

# Ground
Material "diffuse" "rgb reflectance" [ 0.2 0.2 0.2 ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.95 0.85 0.55 ] "float roughness" [ 0.05 ]
  Translate -5 1 0
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd
AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.95 0.85 0.55 ] "float roughness" [ 0.2 ]
  Translate -2.5 1 0
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd
AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.95 0.85 0.55 ] "float roughness" [ 0.4 ]
  Translate 0 1 0
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd
AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.95 0.85 0.55 ] "float roughness" [ 0.6 ]
  Translate 2.5 1 0
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd
AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.95 0.85 0.55 ] "float roughness" [ 0.8 ]
  Translate 5 1 0
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd

# Large area light above: Q=(-6,6,-4) u=(12,0,0) v=(0,0,8), facing down (u x v = -y)
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 6 6 6 ]
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -6 6 -4   6 6 -4   6 6 4   -6 6 4 ]
AttributeEnd
