# @rt-size 12
# alpha-cutout.pbrt -- regression scene for a Shape's "texture alpha" cutout mask (pbrt-v4's stochastic alpha test).
#
# A red diffuse square carries images/alpha-cutout-mask.png as its "alpha": a 64x64 mask whose black texels are transparent (a round
# hole in the middle and checker-shaped notches in the corners). Through the hole and the notches a green wall behind it shows. The
# square is lit by a tall area light and a dim sky. Rendered by the CPU, both OptiX backends and Metal (Metal tests the mask in an
# intersection function; before that it ignored alpha and drew the square solid).
#
# Original, so it carries no licence constraints.

LookAt 0 0 7  0 0 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 200 ] "integer yresolution" [ 200 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
WorldBegin

LightSource "infinite" "rgb L" [ 0.3 0.3 0.3 ]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 14 14 14 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -3 4 3   3 4 3   3 4 -1   -3 4 -1 ]
AttributeEnd

# the wall behind
Material "diffuse" "rgb reflectance" [ 0.1 0.6 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -6 -4 -2   6 -4 -2   6 4 -2   -6 4 -2 ]

# the cutout square, in front
Texture "cutout" "float" "imagemap" "string filename" [ "../images/alpha-cutout-mask.png" ]
Material "diffuse" "rgb reflectance" [ 0.8 0.1 0.1 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -2 -2 0   2 -2 0   2 2 0   -2 2 0 ]
  "point2 uv" [ 0 0  1 0  1 1  0 1 ] "texture alpha" [ "cutout" ]
