# dielectric-medium-showcase.pbrt -- migration of the native "E3 Dielectric
# Medium Showcase" demo scene (src/TheRestOfYourLife/scenes_advanced.h's
# build_dielectric_medium_scene()) to a pbrt-backed scene, part of this
# project's GPU scene-construction-duplication elimination.
#
# Each sphere is a real dielectric surface (eta=1.5) combined with
# MediumInterface on the same Shape declaration - native adds the SAME
# boundary sphere to the world twice (once as a plain dielectric, once
# wrapped in constant_medium), so the glass surface is genuinely visible,
# matching subsurface-slab.pbrt's identical convention.
#
# sigma_s derivation: native's constant_medium(boundary, sigma_t, albedo)
# 3-arg constructor treats sigma_t as a flat scattering-only density
# (sigma_a=0, sigma_s=sigma_t) - same formula as cornell-smoke.pbrt's own
# header comment, just with native's own parameter already named sigma_t
# instead of "density".
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  0 3 18    0 1.5 0    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.5 0.7 1.0 ]

Material "diffuse" "rgb reflectance" [ 0.4 0.5 0.3 ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

# Thin red mist
MakeNamedMedium "mist-red" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 1.2900636431 0.2866808096 0.2866808096 ]
AttributeBegin
  Translate -4 1.5 0
  Material "dielectric" "float eta" [ 1.5 ]
  MediumInterface "mist-red" ""
  Shape "sphere" "float radius" [ 1.5 ]
AttributeEnd

# Medium green haze
MakeNamedMedium "haze-green" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 0.4714460823 1.8857843291 0.7071691234 ]
AttributeBegin
  Translate 0 1.5 0
  Material "dielectric" "float eta" [ 1.5 ]
  MediumInterface "haze-green" ""
  Shape "sphere" "float radius" [ 1.5 ]
AttributeEnd

# Dense blue fog
MakeNamedMedium "fog-blue" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 2.1695111368 2.8926815158 6.5085334105 ]
AttributeBegin
  Translate 4 1.5 0
  Material "dielectric" "float eta" [ 1.5 ]
  MediumInterface "fog-blue" ""
  Shape "sphere" "float radius" [ 1.5 ]
AttributeEnd
