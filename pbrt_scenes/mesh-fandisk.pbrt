# mesh-fandisk.pbrt -- migration of the native "G19" mesh-gallery scene (scenes_mesh_gallery.h's
# build_fandisk() + its GPU twin in scene_builder_mesh_gallery.h) to a pbrt-backed scene. Every number
# below was transcribed by a one-off generator from those builders and the registry row, not
# retyped.
#
# The mesh is a Wavefront OBJ named by Shape "plymesh" (this project's loader reads .obj by
# extension - src/shared/ply_mesh.h's OBJ SUPPORT note), relative to this file, so the multi-
# megabyte asset in models/ is used as-is. It carries no vn records, so it shades with flat
# per-face normals exactly like the native scene. Native metal(albedo, fuzz) is expressed as
# Material "conductor" with the same reflectance and roughness = fuzz, as every earlier
# migration did. The file is skipped by the suite when the asset is absent (registry
# requires_files=true).

LookAt  4 9 4    0 1.5 0    0 1 0
Camera "perspective" "float fov" [ 35 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 150 ]

WorldBegin

# Flat sky = the native scene's constant background colour.
LightSource "infinite" "rgb L" [ 0.05 0.05 0.08 ]

AttributeBegin
  Scale 0.8 0.8 0.8
  Texture "ground-checker" "spectrum" "checkerboard" "integer dimension" [ 3 ]
    "rgb tex1" [ 0.15 0.15 0.15 ] "rgb tex2" [ 0.85 0.85 0.85 ]
AttributeEnd
Material "diffuse" "texture reflectance" [ "ground-checker" ]
AttributeBegin
  Translate 0 -1000 0
  Shape "sphere" "float radius" [ 1000 ]
AttributeEnd

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 6 6 6 ]
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  Translate 0 8 0
  Shape "sphere" "float radius" [ 2 ]
AttributeEnd

AttributeBegin
  Material "conductor" "rgb reflectance" [ 0.55 0.56 0.58 ] "float roughness" [ 0.1 ]
  Translate -1.3807 -7.2097 0.7664
  Scale 0.5719733 0.5719733 0.5719733
  Shape "plymesh" "string filename" [ "../models/fandisk.obj" ]
AttributeEnd
