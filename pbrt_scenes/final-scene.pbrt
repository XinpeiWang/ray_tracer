# ---------------------------------------------------------- area light
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 7 7 7 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 123 554 147   423 554 147   423 554 412   123 554 412 ]
AttributeEnd

# ---------------------------------------------------------- moving sphere
Material "diffuse" "rgb reflectance" [ 0.7 0.3 0.1 ]
AttributeBegin
  ActiveTransform "StartTime"
  Translate 400 400 200
  ActiveTransform "EndTime"
  Translate 430 400 200
  ActiveTransform "All"
  Shape "sphere" "float radius" [ 50 ]
AttributeEnd

# ---------------------------------------------------------- dielectric sphere
Material "dielectric" "float eta" [ 1.5 ]
AttributeBegin
  Translate 260 150 45
  Shape "sphere" "float radius" [ 50 ]
AttributeEnd

# ---------------------------------------------------------- metal sphere
Material "conductor" "rgb reflectance" [ 0.8 0.8 0.9 ] "float roughness" [ 1.0 ]
AttributeBegin
  Translate 0 150 145
  Shape "sphere" "float radius" [ 50 ]
AttributeEnd

# ---------------------------------------------------------- small blue fog sphere
MakeNamedMedium "fog-blue-small" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 0.04 0.08 0.18 ]
AttributeBegin
  Translate 360 150 145
  Material "dielectric" "float eta" [ 1.5 ]
  MediumInterface "fog-blue-small" ""
  Shape "sphere" "float radius" [ 70 ]
AttributeEnd

# ---------------------------------------------------------- giant whole-scene haze
MakeNamedMedium "worldhaze" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0 0 0 ] "rgb sigma_s" [ 0.0001 0.0001 0.0001 ]
AttributeBegin
  Material "dielectric" "float eta" [ 1.5 ]
  MediumInterface "worldhaze" ""
  Shape "sphere" "float radius" [ 5000 ]
AttributeEnd

# ---------------------------------------------------------- earth-image sphere
Texture "earth-tex" "spectrum" "imagemap" "string filename" [ "images/earthmap.jpg" ]
Material "diffuse" "texture reflectance" [ "earth-tex" ]
AttributeBegin
  Translate 400 200 400
  Shape "sphere" "float radius" [ 100 ]
AttributeEnd

# ---------------------------------------------------------- noise sphere (fbm approximation - see header)
Texture "noise-tex" "spectrum" "fbm"
Material "diffuse" "texture reflectance" [ "noise-tex" ]
AttributeBegin
  Translate 220 280 300
  Shape "sphere" "float radius" [ 80 ]
AttributeEnd

