# @rt-size 6
# colored-quads.pbrt -- migration of the native "A6 Colored Quads" demo scene
# (src/TheRestOfYourLife/scenes_book.h's build_quads()/build_quads_lights(),
# gpu/optix/scene_builder.cpp's build_quads_scene()) to a pbrt-backed scene,
# part of this project's GPU scene-construction-duplication elimination.
#
# Five axis-aligned colored quads (Ray Tracing: The Next Week's classic
# "quads" scene) plus one floating rectangular light. Each quad here is
# authored as two triangles (0 1 2, 0 2 3) from the SAME corner point Q and
# edge vectors u,v the native quad(Q,u,v,mat) constructor uses, in the same
# P0=Q, P1=Q+u, P2=Q+u+v, P3=Q+v order - this makes the two triangles' normal
# (cross(P1-P0,P2-P0) = cross(u,v)) match quad.h's own cross(u,v) convention
# exactly, so orientation-dependent shading (the light's one-sided emission)
# comes out identical to the native scene's.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  0 0 9    0 0 0    0 1 0
Camera "perspective" "float fov" [ 80 ]

Film "rgb" "integer xresolution" [ 400 ] "integer yresolution" [ 400 ]
Sampler "halton" "integer pixelsamples" [ 100 ]

WorldBegin

# Flat sky-blue background (native CameraConfig bg = 0.70 0.80 1.00) -
# wire_pbrt_backed_scene() zeroes the background unconditionally unless the
# file declares its own infinite light, so this is required for parity, not
# decorative.
LightSource "infinite" "rgb L" [ 0.70 0.80 1.00 ]

# left_red: Q=(-3,-2,5) u=(0,0,-4) v=(0,4,0)
Material "diffuse" "rgb reflectance" [ 1.0 0.2 0.2 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -3 -2 5   -3 -2 1   -3 2 1   -3 2 5 ]

# back_green: Q=(-2,-2,0) u=(4,0,0) v=(0,4,0)
Material "diffuse" "rgb reflectance" [ 0.2 1.0 0.2 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -2 -2 0   2 -2 0   2 2 0   -2 2 0 ]

# right_blue: Q=(3,-2,1) u=(0,0,4) v=(0,4,0)
Material "diffuse" "rgb reflectance" [ 0.2 0.2 1.0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 3 -2 1   3 -2 5   3 2 5   3 2 1 ]

# upper_orange: Q=(-2,3,1) u=(4,0,0) v=(0,0,4)
Material "diffuse" "rgb reflectance" [ 1.0 0.5 0.0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -2 3 1   2 3 1   2 3 5   -2 3 5 ]

# lower_teal: Q=(-2,-3,5) u=(4,0,0) v=(0,0,-4)
Material "diffuse" "rgb reflectance" [ 0.2 0.8 0.8 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -2 -3 5   2 -3 5   2 -3 1   -2 -3 1 ]

# lamp: Q=(-1,0.5,3) u=(2,0,0) v=(0,1,0), diffuse_light(color(7,7,6.5)) -
# one-sided by default, matching AreaLightSource "diffuse"'s own default
# twosided=false.
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 7 7 6.5 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -1 0.5 3   1 0.5 3   1 1.5 3   -1 1.5 3 ]
AttributeEnd
