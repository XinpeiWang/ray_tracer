# punctual-lights.pbrt -- exercises all 5 of pbrt-v4's punctual (delta-
# distribution) light kinds in one scene: point, spot, distant, goniometric,
# and projection. Every other bundled example scene lit its room with
# AreaLightSource alone, so the entire punctual-light bridging code in
# pbrt_flatten.h - and both backends' delta-light shading paths - had no
# render-level regression coverage from this folder, despite having their
# own dedicated C2-C6 showcase scenes in scenes_advanced.h. goniometric and
# projection below deliberately name no profile/slide file, which is the
# documented "Approx" fallback (uniform isotropic intensity / uniform white
# beam) on both backends - the common case a real-world scene actually hits,
# not just the ideal one.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

# point/spot/goniometric/projection are inverse-square (pbrt-v4 "I" is
# radiant INTENSITY, W/sr) at a ~300-500 unit distance in this room, so
# their "I" needs to be roughly (distance^2) times an area light's "L" for
# comparable brightness - these values were tuned by eye, not computed, to
# actually light the room instead of reading as a near-black regression.
LightSource "point" "point3 from" [ 100 450 100 ] "rgb I" [ 55000 50000 45000 ]

# spot: aimed from a back corner down at the sphere
LightSource "spot" "point3 from" [ 450 500 450 ] "point3 to" [ 278 0 278 ]
  "float coneangle" [ 35 ] "float conedeltaangle" [ 8 ] "rgb I" [ 90000 80000 110000 ]

# distant: a directional "sun" from high in +y - unlike the four inverse-
# square kinds above, "L" here is plain radiance with no distance falloff,
# so it stays in the same order of magnitude as an area light's own L.
LightSource "distant" "point3 from" [ 0 600 -100 ] "point3 to" [ 278 0 278 ]
  "rgb L" [ 1.2 1.2 1.4 ]

# goniometric: positioned via the CTM (Translate), not "from"/"to" - see
# pbrt_flatten.h's own comment on why this kind has neither parameter.
AttributeBegin
  Translate 278 500 100
  LightSource "goniometric" "rgb I" [ 40000 35000 20000 ] "float scale" [ 3 ]
AttributeEnd

# projection: also CTM-positioned/aimed; rotated to face down at the floor.
AttributeBegin
  Translate 278 500 450
  Rotate 90 1 0 0
  LightSource "projection" "float fov" [ 35 ] "float scale" [ 60000 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   555 0 0   555 0 555   0 0 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 555 555   0 555 555 ]
Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 0   0 0 555   0 555 555   0 555 0 ]

AttributeBegin
  Translate 278 130 278
  Shape "sphere" "float radius" [ 120 ]
AttributeEnd
