# environment-san-miguel.pbrt -- migration of the native "H5 San Miguel" environment scene (scenes_mesh_gallery.h's build_*()
# + its GPU twin in scene_builder_mesh_gallery.h) to a pbrt-backed scene. Generated, not retyped:
# a one-off script ported load_obj_mtl()'s per-material rules (mesh_mtl.h) to explicit pbrt directives.
#
# The mesh is models/san_miguel.obj, named once per .mtl material as Shape "plymesh" "file.obj#material"
# (ply_mesh.h's OBJ group paths), so the multi-megabyte asset stays where it is. Per material: Ke -> an
# area light; illum 7 (or illum 4/6 with a real Tf and no map_Kd) -> dielectric ("rgb tf" is the .mtl
# transmission filter); illum 2/3 with a real Ks -> conductor; map_Kd -> a diffuse imagemap; else Kd;
# map_Bump -> a displacement texture (a float imagemap for a grayscale bump, a spectrum one for a
# tangent-space normal map); map_d -> the Shape's alpha cutout. Faces whose material the .mtl does not
# define use the native scene's fallback colour.
#
# Materials: emissive=1, glass=3, metal=260, textured=20, flat=3, bump=1, normal=56 (of 287 shapes)
# Requires models/san_miguel.obj and models/san_miguel_textures/ (registry requires_files=true).

LookAt  10 3 5    0 3 0    0 1 0
Camera "perspective" "float fov" [ 45 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 150 ]

WorldBegin

# Flat sky = the native scene's constant sky_light colour.
LightSource "infinite" "rgb L" [ 1.4 1.68 2 ]

Texture "c0" "spectrum" "imagemap" "string filename" [ "../models/san_miguel_textures/textures/N_PITTED.png" ]
