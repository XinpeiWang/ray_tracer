# @rt-size 555
# cornell-rough-glass.pbrt -- migration of the native "B3 Cornell Rough
# Glass" demo scene (src/TheRestOfYourLife/scenes_materials.h's
# build_cornell_rough_glass(), gpu/optix/scene_builder.cpp's
# build_cornell_rough_glass()) to a pbrt-backed scene, part of this
# project's GPU scene-construction-duplication elimination (pilot batch).
# Also fixes I5/I10 (Firefly Suppression / Regularize demo scenes), which
# reuse "the same world as B3" - see scene_registry_data.h's own comment on
# those entries.
#
# Walls/light/box are IDENTICAL to cornell-box-native.pbrt (all three read
# from src/shared/cornell_box_data.h at the C++ level) - see that file's own
# header comment for the quad/box authoring convention this reuses verbatim.
# Background is (0,0,0) - cornell_box_data.h's own default, no
# LightSource "infinite" needed (unlike A6/A1/B4's own nonzero backgrounds).
#
# Rough dielectric sphere: pbrt-v4's own convention (confirmed against
# docs/PBRT_SUPPORT.md) is that "dielectric" with a nonzero "float roughness"
# routes to the real RoughDielectricBxDF/MaterialType::RoughDielectric model
# on both backends - there is no separate "roughdielectric" material name to
# reach for, matching this codebase's own rough_dielectric(ior, roughness)
# constructor exactly (same RoughnessToAlpha() remap on both sides).
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

# ---------------------------------------------------------------- light
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 15 15 15 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 213 554 227   343 554 227   343 554 332   213 554 332 ]
AttributeEnd

# ---------------------------------------------------------------- walls
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 555 555   555 555 555 ]

# ---------------------------------------------------------------- contents
# White diffuse box (same as A1's own box, plain lambertian white).
AttributeBegin
  Translate 265 0 295
  Rotate 15 0 1 0
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 165   165 0 165   165 330 165   0 330 165 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 165   165 0 0   165 330 0   165 330 165 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 0   0 0 0   0 330 0   165 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   0 0 165   0 330 165   0 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 330 165   165 330 165   165 330 0   0 330 0 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   165 0 0   165 0 165   0 0 165 ]
AttributeEnd

# Rough glass sphere: ior 1.5, roughness 0.2 (frosted glass)
Material "dielectric" "float eta" [ 1.5 ] "float roughness" [ 0.2 ]
AttributeBegin
  Translate 190 90 190
  Shape "sphere" "float radius" [ 90 ]
AttributeEnd
