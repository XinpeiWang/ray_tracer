# blackbody-light.pbrt -- exercises "blackbody L" colour-temperature area
# lights (previously silently defaulted to flat white regardless of the
# requested Kelvin value - ParamList::getVec3 requires >=3 numbers, and a
# "blackbody L" [3500] param has exactly 1, so it always fell through to the
# default colour; see resolveEmissionColor()'s own comment in
# pbrt_flatten.h and docs/PBRT_SUPPORT.md). The real motivating scenes
# (barcelona-pavilion/pavilion-night.pbrt, contemporary-bathroom) are large
# downloaded bundles (gitignored, not always present - see
# pbrt_scenes/README.md), so this is a small, always-present, self-contained
# scene demonstrating the same fix.
#
# Two identical square panel lights side by side, same "float scale", same
# distance from the floor - the only difference is colour temperature: left
# panel 2500K (warm incandescent-orange), right panel 9000K (cool overcast-
# blue). If blackbody emission silently fell back to flat white again, both
# halves of the floor would read as the same neutral grey; the whole point
# of this scene is that they visibly don't.
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  0 3 9    0 0 0    0 1 0
Camera "perspective" "float fov" [ 45 ]

Film "rgb" "integer xresolution" [ 640 ] "integer yresolution" [ 400 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

Material "diffuse" "rgb reflectance" [ 0.8 0.8 0.8 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -4   4 0 -4   4 0 4   -4 0 4 ]

AttributeBegin
  Translate -1.6 3 0
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "blackbody L" [ 2500 ] "float scale" [ 60 ] "bool twosided" [ true ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -1 0 -1   1 0 -1   1 0 1   -1 0 1 ]
AttributeEnd

AttributeBegin
  Translate 1.6 3 0
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "blackbody L" [ 9000 ] "float scale" [ 60 ] "bool twosided" [ true ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -1 0 -1   1 0 -1   1 0 1   -1 0 1 ]
AttributeEnd
