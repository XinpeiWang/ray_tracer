# @rt-size 555
# cornell-orthographic.pbrt -- migration of the native "D6 Orthographic
# Camera Cornell Box" demo scene (src/TheRestOfYourLife/scene_registry_data.h's
# D6 entry - the exact same build_cornell_box()/build_cornell_box_lights()
# world as A1/D5/D7/D8, viewed with a parallel-projection camera instead of
# a perspective one) to a pbrt-backed scene, part of this project's GPU
# scene-construction-duplication elimination.
#
# Cornell box geometry is IDENTICAL to cornell-box-native.pbrt (A1) - see
# that file's own header comment for the quad/box-face authoring convention.
#
# Screen window: orthographic has no fov to derive a scale from, so pbrt-v4's
# own "screenwindow" camera parameter is used explicitly, matching the
# native scene's own hand-tuned scale exactly - native computes
# compute_screen_window(image_width, image_height, ...) (+-1 on the wider
# axis, +-1/aspect on the narrower one) then scales by 320 (chosen there via
# a ray-vs-AABB sweep so the 555-unit box fills close to half the frame).
# AT SQUARE RESOLUTION (this project's own CLI always renders width==height
# - see launcher_args.h - so this is the only resolution this scene is ever
# actually driven at), compute_screen_window's square-aspect branch gives
# exactly +-1 on both axes, so the pre-scaled screenwindow below
# (+-320 on both axes) reproduces the native scene's own numbers exactly.
# An explicit screenwindow is a fixed WORLD-SPACE value, unlike native's own
# lambda (which recomputes from cam.image_width/height on every call) - a
# render at a non-square resolution would see the two diverge, but this
# loader's own CLI cannot produce one (this generic pbrt "orthographic"
# camera path IS resolution/aspect-aware in general - see this loader's own
# hasScreenWindow-absent branch, which calls the identical
# compute_screen_window() - just not exercised differently here since the
# CLI only ever asks for a square frame).
#
# Original, not derived from any distributed scene, so it carries no licence
# constraints.

LookAt  278 278 -800    278 278 278    0 1 0
Camera "orthographic" "float screenwindow" [ -320 320 -320 320 ]

Film "rgb" "integer xresolution" [ 600 ] "integer yresolution" [ 600 ]
Sampler "halton" "integer pixelsamples" [ 200 ]

WorldBegin

# ---------------------------------------------------------------- light
# Main ceiling light: Q=(213,554,227) u=(130,0,0) v=(0,0,105), color (15,15,15)
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 15 15 15 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 213 554 227   343 554 227   343 554 332   213 554 332 ]
AttributeEnd

# ---------------------------------------------------------------- walls
# Right wall (green): Q=(555,0,0) u=(0,0,555) v=(0,555,0)
Material "diffuse" "rgb reflectance" [ 0.12 0.45 0.15 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 0   555 0 555   555 555 555   555 555 0 ]

# Left wall (red): Q=(0,0,555) u=(0,0,-555) v=(0,555,0)
Material "diffuse" "rgb reflectance" [ 0.65 0.05 0.05 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   0 0 0   0 555 0   0 555 555 ]

Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
# Ceiling (white): Q=(0,555,0) u=(555,0,0) v=(0,0,555)
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 555 0   555 555 0   555 555 555   0 555 555 ]
# Floor (white): Q=(0,0,555) u=(555,0,0) v=(0,0,-555)
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 0 0 555   555 0 555   555 0 0   0 0 0 ]
# Back wall (white): Q=(555,0,555) u=(-555,0,0) v=(0,555,0)
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 555 0 555   0 0 555   0 555 555   555 555 555 ]

# ---------------------------------------------------------------- contents
# Rotated white box (kBox: min=(0,0,0) max=(165,330,165), rotate_y=15,
# translate=(265,0,295)) - 6 faces from quad.h's own box() algebra.
Material "diffuse" "rgb reflectance" [ 0.73 0.73 0.73 ]
AttributeBegin
  Translate 265 0 295
  Rotate 15 0 1 0
  # front: Q=(0,0,165) u=(165,0,0) v=(0,330,0)
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 165   165 0 165   165 330 165   0 330 165 ]
  # right: Q=(165,0,165) u=(0,0,-165) v=(0,330,0)
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 165   165 0 0   165 330 0   165 330 165 ]
  # back: Q=(165,0,0) u=(-165,0,0) v=(0,330,0)
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 165 0 0   0 0 0   0 330 0   165 330 0 ]
  # left: Q=(0,0,0) u=(0,0,165) v=(0,330,0)
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   0 0 165   0 330 165   0 330 0 ]
  # top: Q=(0,330,165) u=(165,0,0) v=(0,0,-165)
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 330 165   165 330 165   165 330 0   0 330 0 ]
  # bottom: Q=(0,0,0) u=(165,0,0) v=(0,0,165)
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ 0 0 0   165 0 0   165 0 165   0 0 165 ]
AttributeEnd

# Glass sphere: center (190,90,190) radius 90 ior 1.5
Material "dielectric" "float eta" [ 1.5 ]
AttributeBegin
  Translate 190 90 190
  Shape "sphere" "float radius" [ 90 ]
AttributeEnd
