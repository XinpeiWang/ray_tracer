# @rt-category Test Scenes
# camera-medium-absorbing.pbrt -- regression scene for pbrt's camera medium (a MediumInterface before the Camera
# directive: the camera sits inside an unbounded fog) on all three backends.
#
# A fog with absorption (sigma_a 0.05, sigma_s 0.2: albedo 0.8) lit by a point light, with a bright emitter far
# behind it seen through the fog. Four things used to be wrong, each visible here:
#   * CPU and recursive GPU multiplied a ray that got through the fog by its transmittance a second time (the
#     free-flight sample already picks "pass" with probability T): the emitter rendered at exp(-2 d sigma) not
#     exp(-d sigma_t);
#   * recursive GPU never weighted the path that continues after a scatter by the scattering albedo, and its builder
#     dropped the sigma_s/sigma_t factor from the albedo (~2x too bright by the eighth bounce);
#   * wavefront GPU had no camera medium at all (this scene rendered with no fog).
# A Monte Carlo solution of the same fog without the emitter gives 0.614 / 0.978 / 1.316 / 1.503 mean linear
# radiance cumulated over 1 / 2 / 4 / 8 scatters; all three backends now land on it within 3%.
#
# See tests/unit/pbrt_example_scenes_tests.cpp (CameraMediumAbsorbingAgreesAcrossBackends).

MakeNamedMedium "fog" "string type" [ "homogeneous" ]
  "rgb sigma_a" [ 0.05 0.05 0.05 ] "rgb sigma_s" [ 0.2 0.2 0.2 ] "float g" [ 0 ]
MediumInterface "" "fog"

LookAt 0 0 0  0 0 -1  0 1 0
Camera "perspective" "float fov" [ 60 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

LightSource "point" "rgb I" [ 300 300 300 ] "point3 from" [ 0 3 -6 ]

AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 3 3 3 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -3 -3 -12   3 -3 -12   3 3 -12   -3 3 -12 ]
AttributeEnd
