##############################################################################
# Package / Deployment Directory (except tracked files)
##############################################################################

# RayTracer deployment package build outputs
RayTracer_Package/*.exe
RayTracer_Package/*.dll
RayTracer_Package/*.ptx
RayTracer_Package/output/
RayTracer_Package/platforms/
RayTracer_Package/styles/

# Keep deployment script
!RayTracer_Package/*.ps1

##############################################################################
# Test / Render Output
##############################################################################

# Generated images
*.ppm
*.png
*.jpg
*.jpeg
*.bmp
*.tga

# Keep example/reference images if needed
!docs/*.png
!docs/*.jpg

# ...and real texture assets under images/ (e.g. earthmap.jpg for scenes
# 3/8) - same reasoning as models/*.obj above: the broad *.jpg/*.png rules
# above are meant for generated render output, not source texture data
# that happens to share the extension.
!images/*.jpg
!images/*.png

# ...and real mesh texture assets under models/sponza_textures/ and
# models/bistro_textures/ (map_Kd images for scenes 62/63 - see
# src/TheRestOfYourLife/mesh.h's load_obj_mtl()) - same reasoning as
# images/*.png above.
!models/sponza_textures/**/*.png
!models/bistro_textures/**/*.png

# ...and the hand-generated 4x4 UV-checker texture used by
# pbrt_scenes/trianglemesh-uv.pbrt to verify "point2 uv" parsing - same
# reasoning as images/*.png above, not generated render output.
!pbrt_scenes/uv-checker.bmp

# ...and the hand-generated 8x4 non-square checker texture used by
# pbrt_scenes/projection-light-nonsquare.pbrt to verify aspect-correct
# LightSource "projection" image handling - same reasoning as
# uv-checker.bmp above.
!pbrt_scenes/nonsquare-checker.bmp

# Test output
test_*.ppm
test_*.png
test_build.*
*.run_marker.txt

# Output directories
output/
qt_gui/output/
RayTracer_Package/output/

