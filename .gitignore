##############################################################################
# C/C++ Build Artifacts
##############################################################################

# Compiled Object files
*.slo
*.lo
*.o
*.obj
# ...except real Wavefront OBJ mesh assets under models/ (e.g. scene 38's
# stanford-bunny.obj) - *.obj above is meant for compiler build artifacts,
# not 3D geometry that happens to share the extension.
!models/*.obj

# Backup / temp / stash files
*.bak
*.tmp
*_stash.h
*_backup.h
build.log

# Root-level stray executables (build artifacts)
/*.exe

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug symbols
*.pdb
*.ilk
*.idb

##############################################################################
# CUDA / OptiX Build Artifacts
##############################################################################

# CUDA compiled files
*.ptx
*.cubin
*.fatbin

# OptiX PTX (keep the checked-in version for deployment)
!gpu/optix/optix_programs.ptx

# CUDA object files
gpu/cuda/obj/
*.cu.obj

