      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{9A3B9C2D-4E5F-6A7B-8C9D-0E1F2A3B4C5D}</ProjectGuid>
    <RootNamespace>optix_renderer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <!-- WholeProgramOptimization (LTCG, i.e. /GL) removed - same reasoning
         as cpu_renderer.vcxproj's identical change: any static lib's own
         /GL-compiled objects can trigger "fatal error LNK1103: debugging
         information corrupt" in a downstream consumer that also has LTCG
         enabled when it needs to relink after a source change in this
         project (this class of bug hit three different consumer projects
         this session - see cpu_renderer.vcxproj's comment for the root-
         cause trace). Removed here proactively rather than waiting for it
         to reproduce with this project's own .cpp files (scene_builder.cpp
         etc. - the .cu device code compiles through a separate nvcc path
         unaffected by this flag). This project links into a CLI renderer
         and test binaries, not a performance-critical shared library
         consumed by external code - no meaningful optimization loss. -->
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- Use MSBuildProjectDirectory to ensure correct output path regardless of build context -->
    <OutDir>$(MSBuildProjectDirectory)\..\x64\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>OPTIX_RENDERER_AVAILABLE;_DEBUG;_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <!-- Use configurable OptixSdkPath and CudaToolkitPath properties (can be set via env or MSBuild) -->
      <AdditionalIncludeDirectories>$(OptixSdkPath)\include;$(CudaToolkitPath)\include;$(ProjectDir)gpu\optix;$(ProjectDir)..\src\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>
      </SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Lib>
      <AdditionalDependencies>$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels.obj;$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_launch.obj;$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_dlink.obj;$(MSBuildProjectDirectory)\..\gpu\optix\sppm_kernels.obj;$(MSBuildProjectDirectory)\..\gpu\optix\sppm_launch.obj;$(MSBuildProjectDirectory)\..\gpu\optix\sppm_dlink.obj;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(CudaToolkitPath)\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>OPTIX_RENDERER_AVAILABLE;NDEBUG;_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(OptixSdkPath)\include;$(CudaToolkitPath)\include;$(ProjectDir)gpu\optix;$(ProjectDir)..\src\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>
      </SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Lib>
      <AdditionalDependencies>$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_kernels.obj;$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_launch.obj;$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_dlink.obj;$(MSBuildProjectDirectory)\..\gpu\optix\sppm_kernels.obj;$(MSBuildProjectDirectory)\..\gpu\optix\sppm_launch.obj;$(MSBuildProjectDirectory)\..\gpu\optix\sppm_dlink.obj;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(CudaToolkitPath)\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\gpu\optix\optix_renderer.cpp" />
    <ClCompile Include="..\gpu\optix\optix_interface.cpp" />
    <ClCompile Include="..\gpu\optix\scene_builder.cpp" />
    <ClCompile Include="..\gpu\optix\renderer_config.cpp" />
    <ClCompile Include="..\gpu\optix\recursive_path_tracer.cpp" />
    <ClCompile Include="..\gpu\optix\path_tracing_strategy.cpp" />
    <ClCompile Include="..\gpu\optix\wavefront_path_tracer.cpp" />
    <ClCompile Include="..\gpu\optix\sppm_path_tracer.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\gpu\optix\optix_renderer.h" />
    <ClInclude Include="..\gpu\optix\optix_interface.h" />
    <ClInclude Include="..\gpu\optix\optix_types.h" />
    <ClInclude Include="..\gpu\optix\scene_builder.h" />
    <ClInclude Include="..\gpu\optix\renderer_config.h" />
    <ClInclude Include="..\gpu\optix\path_tracing_strategy.h" />
    <ClInclude Include="..\gpu\optix\recursive_path_tracer.h" />
    <ClInclude Include="..\gpu\optix\wavefront_path_tracer.h" />
    <ClInclude Include="..\gpu\optix\wavefront_types.h" />
    <ClInclude Include="..\gpu\optix\sppm_path_tracer.h" />
    <ClInclude Include="..\gpu\optix\sppm_types.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\gpu\optix\optix_programs.cu" />
    <None Include="..\gpu\optix\wavefront_programs.cu" />
    <None Include="..\gpu\optix\wavefront_kernels.cu" />
    <None Include="..\gpu\optix\wavefront_launch.cu" />
    <None Include="..\gpu\optix\sppm_programs.cu" />
    <None Include="..\gpu\optix\sppm_kernels.cu" />
    <None Include="..\gpu\optix\sppm_launch.cu" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Post-Build Event: Auto-deploy PTX to RayTracer_Package -->
  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <PtxSource>$(MSBuildProjectDirectory)\..\gpu\optix\optix_programs.ptx</PtxSource>
      <PackageDir>$(MSBuildProjectDirectory)\..\RayTracer_Package</PackageDir>
    </PropertyGroup>
    <!-- Create package directory if it doesn't exist -->
    <MakeDir Directories="$(PackageDir)" Condition="!Exists('$(PackageDir)')" />
    <!-- Copy PTX shader to package directory -->
    <Message Text="[Post-Build] Copying optix_programs.ptx to RayTracer_Package..." Importance="high" />
    <Copy SourceFiles="$(PtxSource)" DestinationFiles="$(PackageDir)\optix_programs.ptx" SkipUnchangedFiles="false" Condition="Exists('$(PtxSource)')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_programs.ptx" DestinationFiles="$(PackageDir)\wavefront_programs.ptx" SkipUnchangedFiles="false" Condition="Exists('$(MSBuildProjectDirectory)\..\gpu\optix\wavefront_programs.ptx')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\gpu\optix\sppm_programs.ptx" DestinationFiles="$(PackageDir)\sppm_programs.ptx" SkipUnchangedFiles="false" Condition="Exists('$(MSBuildProjectDirectory)\..\gpu\optix\sppm_programs.ptx')" />
    <Message Text="[Post-Build] Deployed: $(PackageDir)\optix_programs.ptx" Importance="high" Condition="Exists('$(PtxSource)')" />
    <Warning Text="[Post-Build] PTX not found at $(PtxSource). Run PTX compile step first." Condition="!Exists('$(PtxSource)')" />
  </Target>
</Project>



