<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5F2A8E6C-9B3F-4A1D-B7A7-2F9C9E2B4A11}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>raytracing_book</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <!-- WholeProgramOptimization (LTCG, i.e. /GL) removed at the root cause
         rather than patched in every consumer: this static lib's /GL-
         compiled objects (stb_image_impl.obj in particular) reproducibly
         triggered "fatal error LNK1103: debugging information corrupt" in
         every downstream project that itself also had LTCG enabled and
         needed to relink this lib after a cpu_renderer source change -
         hit three separate times this session (tests/ray_tracer_tests.
         vcxproj, launcher/launcher.vcxproj, scene_metadata/
         scene_metadata.vcxproj) before tracing it back here. Disabling it
         on the consumer side each time worked but only for that one
         consumer; disabling it here fixes it for all of them at once and
         for any future one. cpu_renderer.lib is linked into a CLI
         renderer and a handful of DLL/test binaries, not a
         performance-critical shared library consumed by external code -
         there's no meaningful optimization loss from dropping LTCG here. -->
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>..\src;..\src\TheRestOfYourLife;..\src\external;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <DisableSpecificWarnings>4312</DisableSpecificWarnings>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <!-- Matches tests/ray_tracer_tests.vcxproj and optix_renderer.vcxproj,
           which already had this - this project was just missed. Compiles
           this lib's handful of .cpp/.c translation units concurrently
           instead of one at a time. -->
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>..\src;..\src\TheRestOfYourLife;..\src\external;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <DisableSpecificWarnings>4312</DisableSpecificWarnings>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="cpu_interface.cpp" />
    <!-- BDPT/MLT CLI entry points - see cpu_interface_bdpt.cpp's own file
         comment. Kept as its own translation unit organizationally (keeps
         the BDPT/MLT-specific includes/logic out of cpu_interface.cpp) but
         no longer split further into a second .cpp file joined by a bridge
         header - that extra split existed only to route around an
         AliasTable ODR collision that no longer exists. -->
    <ClCompile Include="cpu_interface_bdpt.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="cpu_interface.h" />
    <ClInclude Include="..\src\TheRestOfYourLife\*.h" />
    <ClCompile Include="..\src\external\stb_image_impl.cpp" />
    <ClCompile Include="..\src\external\tinyexr_impl.cpp" />
    <ClCompile Include="..\src\external\miniz.c" />
    <ClInclude Include="..\src\external\*.h" />
    <ClInclude Include="..\src\external\*.hh" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
